using UnityEngine;
using System.Text;
using System.Collections.Generic;

namespace Tartaria.LiveOps
{
    /// <summary>
    /// Stability Monitor — unified runtime dashboard for live ops monitoring.
    /// 
    /// AGENT 1: Live Stability Monitor
    /// 
    /// Aggregates metrics from all monitoring systems:
    /// - CrashReporter (crash count, hitch count)
    /// - PerformanceGuard (budget violations, system timings)
    /// - FrameBudgetMonitor (1%-low frame times)
    /// - Memory profiler (allocated, reserved, GC)
    /// 
    /// Features:
    /// - Real-time stability grade (A-F)
    /// - Frame drop counter (<30 FPS)
    /// - Periodic health reports (every 5 min)
    /// - Public API for external queries
    /// - Lightweight (samples every frame, logs aggregates)
    /// 
    /// Usage:
    ///   StabilityMonitor.Instance.GetHealthReport();
    ///   bool stable = StabilityMonitor.Instance.IsStable();
    ///   
    /// Bootstraps automatically via [RuntimeInitializeOnLoadMethod].
    /// </summary>
    public class StabilityMonitor : MonoBehaviour
    {
        public static StabilityMonitor Instance { get; private set; }

        [Header("Monitoring Configuration")]
        [SerializeField] float healthReportIntervalSeconds = 300f; // 5 minutes
        [SerializeField] float frameDroPthreshold = 30f; // Frames below this = "dropped frame"
        [SerializeField] int criticalFrameDropCount = 100; // >100 drops in report period = warning

        // Frame time tracking
        const int SAMPLE_WINDOW = 300; // 5 seconds at 60 FPS
        float[] _frameTimes = new float[SAMPLE_WINDOW];
        int _frameIndex;
        int _sampleCount;

        // Frame drop tracking
        int _frameDropCount;
        int _frameDropsThisPeriod;

        // Aggregated metrics
        float _avgFPS;
        float _minFPS = float.MaxValue;
        float _p1LowFPS = float.MaxValue;
        long _peakMemoryMB;
        int _budgetViolations;
        
        // Health report timing
        float _nextReportTime;
        float _sessionStartTime;

        [RuntimeInitializeOnLoadMethod(RuntimeInitializeLoadType.AfterSceneLoad)]
        static void Bootstrap()
        {
            if (Instance != null) return;
            var go = new GameObject("[StabilityMonitor]");
            Instance = go.AddComponent<StabilityMonitor>();
            DontDestroyOnLoad(go);
        }

        void Awake()
        {
            if (Instance != null && Instance != this)
            {
                Destroy(gameObject);
                return;
            }

            Instance = this;
            transform.SetParent(null);
            DontDestroyOnLoad(gameObject);

            _sessionStartTime = Time.realtimeSinceStartup;
            _nextReportTime = _sessionStartTime + healthReportIntervalSeconds;

            Debug.Log("[StabilityMonitor] Initialized. Health reports every " + healthReportIntervalSeconds + "s");
        }

        void OnDestroy()
        {
            if (Instance == this)
                Instance = null;
        }

        void Update()
        {
            // Sample frame time
            float frameMs = Time.unscaledDeltaTime * 1000f;
            float fps = 1f / Time.unscaledDeltaTime;

            _frameTimes[_frameIndex] = frameMs;
            _frameIndex = (_frameIndex + 1) % SAMPLE_WINDOW;
            if (_sampleCount < SAMPLE_WINDOW)
                _sampleCount++;

            // Track frame drops
            if (fps < frameDroPthreshold)
            {
                _frameDropCount++;
                _frameDropsThisPeriod++;
            }

            // Track min FPS
            if (fps < _minFPS)
                _minFPS = fps;

            // Track peak memory
            long memMB = UnityEngine.Profiling.Profiler.GetTotalAllocatedMemoryLong() / 1048576;
            if (memMB > _peakMemoryMB)
                _peakMemoryMB = memMB;

            // Calculate avg FPS
            if (_sampleCount > 0)
            {
                float sum = 0f;
                for (int i = 0; i < _sampleCount; i++)
                    sum += _frameTimes[i];
                float avgFrameTime = sum / _sampleCount;
                _avgFPS = 1000f / avgFrameTime;

                // Calculate 1%-low
                var sorted = new List<float>(_frameTimes);
                sorted.Sort();
                int p1Index = Mathf.Max(0, _sampleCount - (_sampleCount / 100) - 1);
                if (p1Index < sorted.Count)
                {
                    float p1FrameTime = sorted[p1Index];
                    _p1LowFPS = 1000f / p1FrameTime;
                }
            }

            // Periodic health report
            if (Time.realtimeSinceStartup >= _nextReportTime)
            {
                LogHealthReport();
                _nextReportTime = Time.realtimeSinceStartup + healthReportIntervalSeconds;
                _frameDropsThisPeriod = 0; // Reset period counter
            }
        }

        void LogHealthReport()
        {
            var report = GetHealthReport();
            
            string grade = GetStabilityGrade();
            bool stable = IsStable();
            
            Debug.Log($"[StabilityMonitor] Health Report ({grade} grade, {(stable ? "STABLE" : "UNSTABLE")})\n{report}");
            
            // Warn on critical conditions
            if (!stable)
            {
                Debug.LogWarning("[StabilityMonitor] STABILITY WARNING: System not meeting production thresholds");
            }

            if (_frameDropsThisPeriod > criticalFrameDropCount)
            {
                Debug.LogWarning($"[StabilityMonitor] PERFORMANCE WARNING: {_frameDropsThisPeriod} frame drops in last {healthReportIntervalSeconds}s");
            }
        }

        /// <summary>
        /// Get comprehensive health report string.
        /// </summary>
        public string GetHealthReport()
        {
            var sb = new StringBuilder();
            sb.AppendLine("=== STABILITY HEALTH REPORT ===");
            sb.AppendLine($"Session Uptime: {Time.realtimeSinceStartup - _sessionStartTime:F1}s");
            sb.AppendLine();

            // Performance
            sb.AppendLine("PERFORMANCE:");
            sb.AppendLine($"  Avg FPS: {_avgFPS:F1}");
            sb.AppendLine($"  Min FPS: {_minFPS:F1}");
            sb.AppendLine($"  1%-Low: {_p1LowFPS:F1}");
            sb.AppendLine($"  Frame Drops (<{frameDroPthreshold} FPS): {_frameDropCount} total, {_frameDropsThisPeriod} this period");
            sb.AppendLine();

            // Memory
            long currentMemMB = UnityEngine.Profiling.Profiler.GetTotalAllocatedMemoryLong() / 1048576;
            sb.AppendLine("MEMORY:");
            sb.AppendLine($"  Current: {currentMemMB}MB");
            sb.AppendLine($"  Peak: {_peakMemoryMB}MB");
            sb.AppendLine($"  GC Collections: {System.GC.CollectionCount(0)}");
            sb.AppendLine();

            // Crashes & Hitches
            sb.AppendLine("CRASHES & HITCHES:");
            sb.AppendLine($"  Crashes: {CrashReporter.GetCrashCount()}");
            sb.AppendLine($"  Hitches (>100ms): {CrashReporter.GetHitchCount()}");
            sb.AppendLine();

            // Performance Guard
            if (PerformanceGuard.Instance != null)
            {
                sb.AppendLine("PERFORMANCE GUARD:");
                sb.AppendLine($"  Budget Violations: {PerformanceGuard.Instance.BudgetExceededCount}");
                sb.AppendLine($"  Worst Frame: {PerformanceGuard.Instance.WorstFrameMs:F1}ms");
                sb.AppendLine($"  In Budget: {PerformanceGuard.Instance.IsInBudget}");
            }

            sb.AppendLine();
            sb.AppendLine($"Stability Grade: {GetStabilityGrade()}");
            sb.AppendLine($"Status: {(IsStable() ? "STABLE ✓" : "UNSTABLE ⚠")}");

            return sb.ToString();
        }

        /// <summary>
        /// Check if system is currently stable (meets production thresholds).
        /// </summary>
        public bool IsStable()
        {
            // P0 conditions for stability
            bool noCrashes = CrashReporter.GetCrashCount() == 0;
            bool fpsAcceptable = _avgFPS >= 30f; // Minimum acceptable FPS
            bool memoryAcceptable = _peakMemoryMB < 4096; // Max 4GB
            bool fewFrameDrops = _frameDropsThisPeriod < criticalFrameDropCount;

            return noCrashes && fpsAcceptable && memoryAcceptable && fewFrameDrops;
        }

        /// <summary>
        /// Get stability grade (A-F based on metrics).
        /// </summary>
        public string GetStabilityGrade()
        {
            int score = 100;

            // Deduct for crashes (each crash = -20 points)
            score -= CrashReporter.GetCrashCount() * 20;

            // Deduct for low FPS
            if (_avgFPS < 30f) score -= 30;
            else if (_avgFPS < 45f) score -= 20;
            else if (_avgFPS < 55f) score -= 10;

            // Deduct for frame drops
            if (_frameDropCount > 500) score -= 20;
            else if (_frameDropCount > 200) score -= 10;
            else if (_frameDropCount > 50) score -= 5;

            // Deduct for hitches
            int hitchCount = CrashReporter.GetHitchCount();
            if (hitchCount > 50) score -= 15;
            else if (hitchCount > 20) score -= 10;
            else if (hitchCount > 5) score -= 5;

            // Deduct for high memory
            if (_peakMemoryMB > 4096) score -= 15;
            else if (_peakMemoryMB > 3500) score -= 5;

            // Grade assignment
            if (score >= 90) return "A";
            if (score >= 80) return "B";
            if (score >= 70) return "C";
            if (score >= 60) return "D";
            return "F";
        }

        /// <summary>
        /// Get current average FPS over sample window.
        /// </summary>
        public float GetAverageFPS() => _avgFPS;

        /// <summary>
        /// Get minimum FPS recorded this session.
        /// </summary>
        public float GetMinFPS() => _minFPS;

        /// <summary>
        /// Get 1%-low FPS (worst 1% of frames).
        /// </summary>
        public float Get1PercentLowFPS() => _p1LowFPS;

        /// <summary>
        /// Get total frame drop count (frames below threshold).
        /// </summary>
        public int GetFrameDropCount() => _frameDropCount;

        /// <summary>
        /// Get peak memory usage (MB).
        /// </summary>
        public long GetPeakMemoryMB() => _peakMemoryMB;

        /// <summary>
        /// Get timestamp of last crash (if any).
        /// </summary>
        public float GetLastCrashTimestamp()
        {
            // Would need to track this in CrashReporter enhancement
            return -1f; // Not implemented yet
        }

        /// <summary>
        /// Reset all tracking stats (call on scene load or explicit reset).
        /// </summary>
        public void ResetStats()
        {
            _frameDropCount = 0;
            _frameDropsThisPeriod = 0;
            _minFPS = float.MaxValue;
            _p1LowFPS = float.MaxValue;
            _peakMemoryMB = 0;
            _budgetViolations = 0;
            _sampleCount = 0;
            _frameIndex = 0;
            System.Array.Clear(_frameTimes, 0, _frameTimes.Length);

            Debug.Log("[StabilityMonitor] Stats reset");
        }

        /// <summary>
        /// Force immediate health report (for debugging or on-demand checks).
        /// </summary>
        public void ForceHealthReport()
        {
            LogHealthReport();
        }
    }
}
