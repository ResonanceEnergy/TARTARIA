using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using UnityEngine;

namespace Tartaria.LiveOps
{
    /// <summary>
    /// Telemetry Dashboard — in-game analytics viewer for developers.
    /// 
    /// AGENT 2: ANALYTICS DASHBOARD
    /// 
    /// Features:
    /// - Event stream (last 50 events)
    /// - Session stats (events fired, upload status)
    /// - Performance metrics (FPS, hitches, crashes)
    /// - Player progression summary
    /// - Heatmap data preview (deaths, stuck locations)
    /// 
    /// Hotkey: F4 (toggle dashboard)
    /// 
    /// Usage:
    ///   - Press F4 to open/close
    ///   - Shows real-time telemetry events
    ///   - Export to CSV for analysis
    /// 
    /// Bootstraps automatically via [RuntimeInitializeOnLoadMethod].
    /// </summary>
    public class TelemetryDashboard : MonoBehaviour
    {
        public static TelemetryDashboard Instance { get; private set; }

        [Header("Configuration")]
        [SerializeField] bool enableDashboard = true;
        [SerializeField] KeyCode toggleKey = KeyCode.F4;

        bool _isVisible = false;
        Vector2 _scrollPosition;
        
        // Event tracking
        Queue<EventLogEntry> _eventLog = new Queue<EventLogEntry>(50);
        int _totalEvents;
        
        // Performance tracking
        int _sessionDeaths;
        int _sessionLevelUps;
        int _sessionQuestsCompleted;
        
        // Heatmap data (simplified preview)
        List<Vector3> _deathLocations = new List<Vector3>();
        List<Vector3> _stuckLocations = new List<Vector3>();

        [RuntimeInitializeOnLoadMethod(RuntimeInitializeLoadType.AfterSceneLoad)]
        static void Bootstrap()
        {
            if (Instance != null) return;
            var go = new GameObject("[TelemetryDashboard]");
            Instance = go.AddComponent<TelemetryDashboard>();
            DontDestroyOnLoad(go);
        }

        void Awake()
        {
            if (Instance != null && Instance != this)
            {
                Destroy(gameObject);
                return;
            }

            Instance = this;
            transform.SetParent(null);
            DontDestroyOnLoad(gameObject);
            
            // Subscribe to telemetry events (if service exists)
            if (enableDashboard)
            {
                Debug.Log("[TelemetryDashboard] Initialized (Press F4 to toggle)");
            }
        }

        void OnDestroy()
        {
            if (Instance == this)
                Instance = null;
        }

        void Update()
        {
            if (Input.GetKeyDown(toggleKey))
            {
                _isVisible = !_isVisible;
            }
        }

        void OnGUI()
        {
            if (!_isVisible || !enableDashboard)
                return;

            // Dark semi-transparent background
            GUI.color = new Color(0f, 0f, 0f, 0.8f);
            GUI.Box(new Rect(0, 0, Screen.width, Screen.height), "");
            GUI.color = Color.white;

            // Dashboard window
            GUILayout.BeginArea(new Rect(50, 50, Screen.width - 100, Screen.height - 100));
            
            GUILayout.BeginVertical("box");
            
            // Header
            GUILayout.Label("<b><size=20>TELEMETRY DASHBOARD</size></b>", RichTextStyle());
            GUILayout.Label($"<color=#888888>Press {toggleKey} to close • Session: {TelemetryService.Instance?.GetStats().Split('\n')[0] ?? "N/A"}</color>", RichTextStyle());
            GUILayout.Space(10);

            // Tabs
            GUILayout.BeginHorizontal();
            if (GUILayout.Button("Session Stats", GUILayout.Height(30)))
            {
                // Tab selection (future enhancement)
            }
            if (GUILayout.Button("Event Stream", GUILayout.Height(30)))
            {
                // Tab selection
            }
            if (GUILayout.Button("Heatmap Data", GUILayout.Height(30)))
            {
                // Tab selection
            }
            GUILayout.EndHorizontal();
            GUILayout.Space(10);

            // Content area (scrollable)
            _scrollPosition = GUILayout.BeginScrollView(_scrollPosition, GUILayout.Height(Screen.height - 250));
            
            DrawSessionStats();
            GUILayout.Space(20);
            DrawEventStream();
            GUILayout.Space(20);
            DrawHeatmapPreview();
            
            GUILayout.EndScrollView();
            
            // Footer
            GUILayout.Space(10);
            GUILayout.BeginHorizontal();
            if (GUILayout.Button("Export to CSV", GUILayout.Height(30)))
            {
                ExportToCSV();
            }
            if (GUILayout.Button("Clear Event Log", GUILayout.Height(30)))
            {
                _eventLog.Clear();
            }
            if (GUILayout.Button("Force Flush Queue", GUILayout.Height(30)))
            {
                TelemetryService.Instance?.ForceFlush();
            }
            GUILayout.EndHorizontal();
            
            GUILayout.EndVertical();
            GUILayout.EndArea();
        }

        void DrawSessionStats()
        {
            GUILayout.Label("<b><size=16>SESSION STATISTICS</size></b>", RichTextStyle());
            GUILayout.Space(5);

            if (TelemetryService.Instance != null)
            {
                string stats = TelemetryService.Instance.GetStats();
                string[] lines = stats.Split('\n');
                foreach (var line in lines)
                {
                    if (!string.IsNullOrEmpty(line))
                    {
                        GUILayout.Label($"  {line}", RichTextStyle());
                    }
                }
            }
            else
            {
                GUILayout.Label("  <color=#ff8888>TelemetryService not initialized</color>", RichTextStyle());
            }

            GUILayout.Space(10);
            GUILayout.Label("<b>Gameplay Metrics:</b>", RichTextStyle());
            GUILayout.Label($"  Deaths: {_sessionDeaths}", RichTextStyle());
            GUILayout.Label($"  Level-Ups: {_sessionLevelUps}", RichTextStyle());
            GUILayout.Label($"  Quests Completed: {_sessionQuestsCompleted}", RichTextStyle());
            
            GUILayout.Space(10);
            GUILayout.Label("<b>Stability Metrics:</b>", RichTextStyle());
            if (StabilityMonitor.Instance != null)
            {
                GUILayout.Label($"  Stability Grade: {StabilityMonitor.Instance.GetStabilityGrade()}", RichTextStyle());
                GUILayout.Label($"  Average FPS: {StabilityMonitor.Instance.GetAverageFPS():F1}", RichTextStyle());
                GUILayout.Label($"  Frame Drops: {StabilityMonitor.Instance.GetFrameDropCount()}", RichTextStyle());
            }
            GUILayout.Label($"  Crashes: {CrashReporter.GetCrashCount()}", RichTextStyle());
            GUILayout.Label($"  Hitches: {CrashReporter.GetHitchCount()}", RichTextStyle());
        }

        void DrawEventStream()
        {
            GUILayout.Label("<b><size=16>EVENT STREAM (Last 50)</size></b>", RichTextStyle());
            GUILayout.Space(5);

            if (_eventLog.Count == 0)
            {
                GUILayout.Label("  <color=#888888>No events logged yet. Play the game to generate telemetry.</color>", RichTextStyle());
                return;
            }

            foreach (var entry in _eventLog.Reverse())
            {
                string color = GetEventColor(entry.eventName);
                GUILayout.Label($"  <color={color}>[{entry.timestamp:HH:mm:ss}]</color> {entry.eventName} — {entry.summary}", RichTextStyle());
            }
        }

        void DrawHeatmapPreview()
        {
            GUILayout.Label("<b><size=16>HEATMAP DATA PREVIEW</size></b>", RichTextStyle());
            GUILayout.Space(5);

            GUILayout.Label($"<b>Death Locations:</b> {_deathLocations.Count} recorded", RichTextStyle());
            if (_deathLocations.Count > 0)
            {
                var topDeaths = _deathLocations.Take(5).ToList();
                foreach (var loc in topDeaths)
                {
                    GUILayout.Label($"  • {loc.x:F0}, {loc.y:F0}, {loc.z:F0}", RichTextStyle());
                }
                if (_deathLocations.Count > 5)
                    GUILayout.Label($"  <color=#888888>... and {_deathLocations.Count - 5} more</color>", RichTextStyle());
            }

            GUILayout.Space(10);
            GUILayout.Label($"<b>Stuck Locations:</b> {_stuckLocations.Count} recorded", RichTextStyle());
            if (_stuckLocations.Count > 0)
            {
                var topStuck = _stuckLocations.Take(5).ToList();
                foreach (var loc in topStuck)
                {
                    GUILayout.Label($"  • {loc.x:F0}, {loc.y:F0}, {loc.z:F0}", RichTextStyle());
                }
                if (_stuckLocations.Count > 5)
                    GUILayout.Label($"  <color=#888888>... and {_stuckLocations.Count - 5} more</color>", RichTextStyle());
            }
        }

        string GetEventColor(string eventName)
        {
            if (eventName.Contains("crash") || eventName.Contains("death") || eventName.Contains("failed"))
                return "#ff4444";
            if (eventName.Contains("completed") || eventName.Contains("level_up"))
                return "#44ff44";
            if (eventName.Contains("performance") || eventName.Contains("hitch"))
                return "#ffaa44";
            return "#aaaaaa";
        }

        GUIStyle RichTextStyle()
        {
            var style = new GUIStyle(GUI.skin.label);
            style.richText = true;
            style.wordWrap = true;
            return style;
        }

        void ExportToCSV()
        {
            try
            {
                string timestamp = DateTime.Now.ToString("yyyyMMdd_HHmmss");
                string csvPath = System.IO.Path.Combine(Application.persistentDataPath, $"telemetry_export_{timestamp}.csv");

                var csv = new StringBuilder();
                csv.AppendLine("Timestamp,Event Name,Summary");
                
                foreach (var entry in _eventLog)
                {
                    csv.AppendLine($"{entry.timestamp:yyyy-MM-dd HH:mm:ss},{entry.eventName},\"{entry.summary}\"");
                }

                System.IO.File.WriteAllText(csvPath, csv.ToString());
                Debug.Log($"[TelemetryDashboard] Exported {_eventLog.Count} events to: {csvPath}");
            }
            catch (Exception ex)
            {
                Debug.LogError($"[TelemetryDashboard] Export failed: {ex.Message}");
            }
        }

        // ═══════════════════════════════════════════════════════════════════
        // PUBLIC API (called by telemetry event handlers)
        // ═══════════════════════════════════════════════════════════════════

        public void LogEvent(string eventName, string summary)
        {
            _totalEvents++;
            _eventLog.Enqueue(new EventLogEntry
            {
                timestamp = DateTime.Now,
                eventName = eventName,
                summary = summary
            });

            if (_eventLog.Count > 50)
                _eventLog.Dequeue();

            // Update gameplay metrics
            if (eventName == TelemetryEvents.PLAYER_DEATH)
                _sessionDeaths++;
            else if (eventName == TelemetryEvents.PLAYER_LEVEL_UP)
                _sessionLevelUps++;
            else if (eventName == TelemetryEvents.QUEST_COMPLETED)
                _sessionQuestsCompleted++;
        }

        public void RecordDeathLocation(Vector3 location)
        {
            _deathLocations.Add(location);
        }

        public void RecordStuckLocation(Vector3 location)
        {
            _stuckLocations.Add(location);
        }

        struct EventLogEntry
        {
            public DateTime timestamp;
            public string eventName;
            public string summary;
        }
    }
}
