using System.Collections.Generic;
using System.Linq;
using UnityEngine;
using Tartaria.Core;
using Tartaria.Core.Enums;

namespace Tartaria.Data.Query
{
    /// <summary>
    /// High-performance crafting recipe registry with indexed lookups.
    /// Indexes recipes by tier and station type for fast filtering.
    /// 
    /// Usage:
    ///   CraftingRecipeRegistry.Initialize(recipeDatabase);
    ///   CraftingRecipeData recipe = CraftingRecipeRegistry.Get("forge_iron_sword");
    ///   var forgeRecipes = CraftingRecipeRegistry.GetByStation(StationType.Forge);
    /// </summary>
    public static class CraftingRecipeRegistry
    {
        static DataRegistry<CraftingRecipeData> _registry;
        static bool _isInitialized;

        // Index names
        const string INDEX_TIER = "tier";
        const string INDEX_STATION = "station";

        /// <summary>
        /// Initializes the registry from CraftingRecipeDatabase.
        /// Call this once at game startup.
        /// </summary>
        public static void Initialize(CraftingRecipeDatabase database)
        {
            if (database == null)
            {
                Debug.LogError("[CraftingRecipeRegistry] Cannot initialize with null database");
                return;
            }

            // Create registry with ID extractor
            _registry = new DataRegistry<CraftingRecipeData>(
                recipe => recipe.recipeId, 
                cacheSize: 50
            );

            // Register secondary indexes
            _registry.RegisterSecondaryIndex(INDEX_TIER, recipe => recipe.requiredTier);
            _registry.RegisterSecondaryIndex(INDEX_STATION, recipe => recipe.requiredStation);

            // Build indexes from database
            _registry.AddRange(database.recipes.Where(r => r != null));

            _isInitialized = true;
            Debug.Log($"[CraftingRecipeRegistry] Initialized with {_registry.Count} recipes");
        }

        /// <summary>
        /// Gets a recipe by ID. O(1) lookup.
        /// </summary>
        public static CraftingRecipeData Get(string recipeId)
        {
            EnsureInitialized();
            return _registry.Get(recipeId);
        }

        /// <summary>
        /// Checks if a recipe exists.
        /// </summary>
        public static bool Contains(string recipeId)
        {
            EnsureInitialized();
            return _registry.Contains(recipeId);
        }

        /// <summary>
        /// Gets all recipes for a specific tier. O(1) lookup.
        /// </summary>
        public static IReadOnlyList<CraftingRecipeData> GetByTier(MaterialTier tier)
        {
            EnsureInitialized();
            return _registry.GetByIndex(INDEX_TIER, tier);
        }

        /// <summary>
        /// Gets all recipes for a specific crafting station. O(1) lookup.
        /// </summary>
        public static IReadOnlyList<CraftingRecipeData> GetByStation(StationType station)
        {
            EnsureInitialized();
            return _registry.GetByIndex(INDEX_STATION, station);
        }

        /// <summary>
        /// Gets all recipes available up to and including the specified tier.
        /// </summary>
        public static List<CraftingRecipeData> GetUpToTier(MaterialTier tier)
        {
            EnsureInitialized();
            
            return _registry.Query()
                .Where(recipe => recipe.requiredTier <= tier)
                .OrderBy(recipe => recipe.requiredTier)
                .ToList();
        }

        /// <summary>
        /// Gets recipes that can be crafted with available materials.
        /// </summary>
        public static List<CraftingRecipeData> GetCraftableRecipes(Dictionary<string, int> inventory)
        {
            EnsureInitialized();
            
            if (inventory == null)
                return new List<CraftingRecipeData>();

            return _registry.Query()
                .Where(recipe => CanCraft(recipe, inventory))
                .OrderBy(recipe => recipe.requiredTier)
                .ToList();
        }

        /// <summary>
        /// Gets recipes by station and tier.
        /// </summary>
        public static List<CraftingRecipeData> GetByStationAndTier(StationType station, MaterialTier tier)
        {
            EnsureInitialized();
            
            return _registry.Query()
                .Where(recipe => recipe.requiredStation == station && recipe.requiredTier == tier)
                .ToList();
        }

        /// <summary>
        /// Gets recipes that produce a specific item.
        /// </summary>
        public static List<CraftingRecipeData> GetRecipesForOutput(string itemId)
        {
            EnsureInitialized();
            
            if (string.IsNullOrEmpty(itemId))
                return new List<CraftingRecipeData>();

            return _registry.Query()
                .Where(recipe => recipe.outputItemId == itemId)
                .ToList();
        }

        /// <summary>
        /// Gets recipes that require a specific ingredient.
        /// </summary>
        public static List<CraftingRecipeData> GetRecipesWithIngredient(string itemId)
        {
            EnsureInitialized();
            
            if (string.IsNullOrEmpty(itemId))
                return new List<CraftingRecipeData>();

            return _registry.Query()
                .Where(recipe => HasIngredient(recipe, itemId))
                .ToList();
        }

        /// <summary>
        /// Creates a fluent query builder for custom queries.
        /// </summary>
        public static QueryBuilder<CraftingRecipeData> Query()
        {
            EnsureInitialized();
            return _registry.Query();
        }

        /// <summary>
        /// Gets all recipes.
        /// </summary>
        public static IReadOnlyList<CraftingRecipeData> GetAll()
        {
            EnsureInitialized();
            return _registry.GetAll();
        }

        /// <summary>
        /// Gets the total recipe count.
        /// </summary>
        public static int Count
        {
            get
            {
                EnsureInitialized();
                return _registry.Count;
            }
        }

        /// <summary>
        /// Clears the registry (for hot-reload/testing).
        /// </summary>
        public static void Clear()
        {
            _registry?.Clear();
            _isInitialized = false;
        }

        static void EnsureInitialized()
        {
            if (!_isInitialized)
            {
                Debug.LogError("[CraftingRecipeRegistry] Not initialized! Call CraftingRecipeRegistry.Initialize(database) first.");
            }
        }

        // Helper to check if recipe can be crafted with available inventory
        static bool CanCraft(CraftingRecipeData recipe, Dictionary<string, int> inventory)
        {
            if (recipe.ingredients == null)
                return true;

            foreach (var ingredient in recipe.ingredients)
            {
                if (!inventory.TryGetValue(ingredient.itemId, out int available))
                    return false;

                if (available < ingredient.quantity)
                    return false;
            }

            return true;
        }

        // Helper to check if recipe has a specific ingredient
        static bool HasIngredient(CraftingRecipeData recipe, string itemId)
        {
            if (recipe.ingredients == null)
                return false;

            foreach (var ingredient in recipe.ingredients)
            {
                if (ingredient.itemId == itemId)
                    return true;
            }

            return false;
        }
    }
}
