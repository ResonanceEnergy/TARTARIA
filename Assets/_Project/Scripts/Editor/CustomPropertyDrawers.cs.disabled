#if UNITY_EDITOR
using UnityEngine;
using UnityEditor;
using Tartaria.Data;
using Tartaria.Core.Enums;

namespace Tartaria.Editor
{
    /// <summary>
    /// Property Drawers for common TARTARIA data types.
    /// Provides enhanced UI rendering for specific field types in the Inspector.
    /// </summary>

    // ─── Item Rarity Drawer ────────────────────────────────────────
    /// <summary>
    /// Color-coded drawer for ItemRarity enum.
    /// </summary>
    [CustomPropertyDrawer(typeof(ItemRarity))]
    public class ItemRarityDrawer : PropertyDrawer
    {
        public override void OnGUI(Rect position, SerializedProperty property, GUIContent label)
        {
            EditorGUI.BeginProperty(position, label, property);

            var rarityValue = (ItemRarity)property.enumValueIndex;
            var color = GetRarityColor(rarityValue);

            // Draw colored background
            var bgRect = position;
            bgRect.x += EditorGUIUtility.labelWidth;
            bgRect.width -= EditorGUIUtility.labelWidth;
            
            var oldColor = GUI.backgroundColor;
            GUI.backgroundColor = color;
            
            EditorGUI.PropertyField(position, property, label);
            
            GUI.backgroundColor = oldColor;

            EditorGUI.EndProperty();
        }

        Color GetRarityColor(ItemRarity rarity)
        {
            return rarity switch
            {
                ItemRarity.Common => new Color(0.8f, 0.8f, 0.8f),
                ItemRarity.Uncommon => new Color(0.2f, 0.9f, 0.2f),
                ItemRarity.Rare => new Color(0.2f, 0.5f, 1f),
                ItemRarity.Epic => new Color(0.7f, 0.2f, 0.9f),
                ItemRarity.Legendary => new Color(1f, 0.6f, 0.1f),
                _ => Color.white
            };
        }
    }

    // ─── Enemy Archetype Drawer ────────────────────────────────────
    /// <summary>
    /// Icon-enhanced drawer for EnemyArchetype enum.
    /// </summary>
    [CustomPropertyDrawer(typeof(EnemyArchetype))]
    public class EnemyArchetypeDrawer : PropertyDrawer
    {
        public override void OnGUI(Rect position, SerializedProperty property, GUIContent label)
        {
            EditorGUI.BeginProperty(position, label, property);

            var archetypeValue = (EnemyArchetype)property.enumValueIndex;
            string icon = GetArchetypeIcon(archetypeValue);

            var labelContent = new GUIContent($"{icon} {label.text}", label.tooltip);
            EditorGUI.PropertyField(position, property, labelContent);

            EditorGUI.EndProperty();
        }

        string GetArchetypeIcon(EnemyArchetype archetype)
        {
            return archetype switch
            {
                EnemyArchetype.Melee => "⚔️",
                EnemyArchetype.Ranged => "🏹",
                EnemyArchetype.Tank => "🛡️",
                EnemyArchetype.Swarm => "🐝",
                EnemyArchetype.Elite => "👑",
                EnemyArchetype.Boss => "👹",
                EnemyArchetype.Support => "💚",
                EnemyArchetype.Caster => "🔮",
                _ => "❓"
            };
        }
    }

    // ─── Vector3 Range Drawer ──────────────────────────────────────
    /// <summary>
    /// Compact drawer for Vector3 with range constraints.
    /// Displays min/max sliders on a single line.
    /// </summary>
    [System.Serializable]
    public struct Vector3Range
    {
        public Vector3 min;
        public Vector3 max;
    }

    [CustomPropertyDrawer(typeof(Vector3Range))]
    public class Vector3RangeDrawer : PropertyDrawer
    {
        public override void OnGUI(Rect position, SerializedProperty property, GUIContent label)
        {
            EditorGUI.BeginProperty(position, label, property);

            position = EditorGUI.PrefixLabel(position, GUIUtility.GetControlID(FocusType.Passive), label);

            var indent = EditorGUI.indentLevel;
            EditorGUI.indentLevel = 0;

            var minProp = property.FindPropertyRelative("min");
            var maxProp = property.FindPropertyRelative("max");

            // Calculate rects
            float halfWidth = position.width * 0.5f;
            var minRect = new Rect(position.x, position.y, halfWidth - 5, position.height);
            var maxRect = new Rect(position.x + halfWidth + 5, position.y, halfWidth - 5, position.height);

            EditorGUI.PropertyField(minRect, minProp, GUIContent.none);
            EditorGUI.PropertyField(maxRect, maxProp, GUIContent.none);

            EditorGUI.indentLevel = indent;
            EditorGUI.EndProperty();
        }

        public override float GetPropertyHeight(SerializedProperty property, GUIContent label)
        {
            return EditorGUIUtility.singleLineHeight;
        }
    }

    // ─── Localization Key Drawer ───────────────────────────────────
    /// <summary>
    /// Enhanced drawer for localization keys with preview button.
    /// </summary>
    [System.Serializable]
    public struct LocalizationKey
    {
        public string key;
        public string defaultValue;
    }

    [CustomPropertyDrawer(typeof(LocalizationKey))]
    public class LocalizationKeyDrawer : PropertyDrawer
    {
        public override void OnGUI(Rect position, SerializedProperty property, GUIContent label)
        {
            EditorGUI.BeginProperty(position, label, property);

            var keyProp = property.FindPropertyRelative("key");
            var defaultProp = property.FindPropertyRelative("defaultValue");

            // Calculate rects
            float buttonWidth = 60f;
            var keyRect = new Rect(position.x, position.y, position.width - buttonWidth - 5, EditorGUIUtility.singleLineHeight);
            var buttonRect = new Rect(position.x + position.width - buttonWidth, position.y, buttonWidth, EditorGUIUtility.singleLineHeight);
            var defaultRect = new Rect(position.x, position.y + EditorGUIUtility.singleLineHeight + 2, position.width, EditorGUIUtility.singleLineHeight);

            // Draw key field
            EditorGUI.PropertyField(keyRect, keyProp, label);

            // Draw preview button
            if (GUI.Button(buttonRect, "Preview"))
            {
                string previewText = !string.IsNullOrEmpty(defaultProp.stringValue) 
                    ? defaultProp.stringValue 
                    : $"[{keyProp.stringValue}]";
                EditorUtility.DisplayDialog("Localization Preview", previewText, "OK");
            }

            // Draw default value field
            EditorGUI.PropertyField(defaultRect, defaultProp, new GUIContent("Default"));

            EditorGUI.EndProperty();
        }

        public override float GetPropertyHeight(SerializedProperty property, GUIContent label)
        {
            return EditorGUIUtility.singleLineHeight * 2 + 2;
        }
    }

    // ─── Float Range Drawer (with visual slider) ───────────────────
    /// <summary>
    /// Drawer for float ranges with min/max fields and visual range slider.
    /// </summary>
    [System.Serializable]
    public struct FloatRange
    {
        public float min;
        public float max;
    }

    [CustomPropertyDrawer(typeof(FloatRange))]
    public class FloatRangeDrawer : PropertyDrawer
    {
        public override void OnGUI(Rect position, SerializedProperty property, GUIContent label)
        {
            EditorGUI.BeginProperty(position, label, property);

            var minProp = property.FindPropertyRelative("min");
            var maxProp = property.FindPropertyRelative("max");

            // First line: label
            var labelRect = new Rect(position.x, position.y, position.width, EditorGUIUtility.singleLineHeight);
            EditorGUI.LabelField(labelRect, label);

            // Second line: min/max sliders
            var sliderRect = new Rect(position.x, position.y + EditorGUIUtility.singleLineHeight + 2, position.width, EditorGUIUtility.singleLineHeight);
            
            float minVal = minProp.floatValue;
            float maxVal = maxProp.floatValue;

            EditorGUI.BeginChangeCheck();
            EditorGUI.MinMaxSlider(sliderRect, ref minVal, ref maxVal, 0f, 100f);
            if (EditorGUI.EndChangeCheck())
            {
                minProp.floatValue = minVal;
                maxProp.floatValue = maxVal;
            }

            // Third line: numeric fields
            var numericRect = new Rect(position.x, position.y + EditorGUIUtility.singleLineHeight * 2 + 4, position.width, EditorGUIUtility.singleLineHeight);
            
            float labelWidth = EditorGUIUtility.labelWidth;
            EditorGUIUtility.labelWidth = 30f;
            
            var minFieldRect = new Rect(numericRect.x, numericRect.y, numericRect.width * 0.5f - 5, numericRect.height);
            var maxFieldRect = new Rect(numericRect.x + numericRect.width * 0.5f + 5, numericRect.y, numericRect.width * 0.5f - 5, numericRect.height);

            EditorGUI.PropertyField(minFieldRect, minProp, new GUIContent("Min"));
            EditorGUI.PropertyField(maxFieldRect, maxProp, new GUIContent("Max"));

            EditorGUIUtility.labelWidth = labelWidth;

            EditorGUI.EndProperty();
        }

        public override float GetPropertyHeight(SerializedProperty property, GUIContent label)
        {
            return EditorGUIUtility.singleLineHeight * 3 + 6;
        }
    }

    // ─── Quest Objective Type Drawer (with icons) ──────────────────
    /// <summary>
    /// Icon-enhanced drawer for QuestObjectiveType enum.
    /// </summary>
    [CustomPropertyDrawer(typeof(Core.QuestObjectiveType))]
    public class QuestObjectiveTypeDrawer : PropertyDrawer
    {
        public override void OnGUI(Rect position, SerializedProperty property, GUIContent label)
        {
            EditorGUI.BeginProperty(position, label, property);

            var objectiveType = (Core.QuestObjectiveType)property.enumValueIndex;
            string icon = GetObjectiveIcon(objectiveType);

            var labelContent = new GUIContent($"{icon} {label.text}", label.tooltip);
            EditorGUI.PropertyField(position, property, labelContent);

            EditorGUI.EndProperty();
        }

        string GetObjectiveIcon(Core.QuestObjectiveType type)
        {
            return type switch
            {
                Core.QuestObjectiveType.DiscoverBuilding => "🏛️",
                Core.QuestObjectiveType.RestoreBuilding => "🔧",
                Core.QuestObjectiveType.DefeatEnemies => "⚔️",
                Core.QuestObjectiveType.TalkToNPC => "💬",
                Core.QuestObjectiveType.CollectItem => "📦",
                Core.QuestObjectiveType.DefeatBoss => "👹",
                Core.QuestObjectiveType.ReachRS => "💎",
                Core.QuestObjectiveType.CompleteTuning => "🎵",
                Core.QuestObjectiveType.CraftItem => "⚒️",
                _ => "📌"
            };
        }
    }
}
#endif
