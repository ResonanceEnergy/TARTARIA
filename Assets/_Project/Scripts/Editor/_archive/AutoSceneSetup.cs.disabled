using UnityEngine;
using UnityEngine.Rendering;
using UnityEditor;
using UnityEditor.SceneManagement;
using System.IO;

namespace Tartaria.Editor
{
    /// <summary>
    /// Auto-Scene Setup Tool — Executes all Moon 1 scene setup tasks automatically
    /// Menu: Tools → TARTARIA → Auto Setup Moon 1 Scene
    /// </summary>
    public class AutoSceneSetup : EditorWindow
    {
        [MenuItem("Tools/TARTARIA/Auto Setup Moon 1 Scene")]
        static void AutoSetupMoon1()
        {
            if (EditorApplication.isPlaying || EditorApplication.isPaused)
            {
                EditorUtility.DisplayDialog("Cannot Run in Play Mode", 
                    "Stop Play Mode (Ctrl+P) first.", "OK");
                return;
            }

            if (!EditorUtility.DisplayDialog(
                "Auto Setup Moon 1 Scene",
                "This will:\n\n" +
                "1. Create Moon1_MagneticMoon.unity (500m terrain)\n" +
                "2. Configure golden hour lighting\n" +
                "3. Add URP Volume Profile\n" +
                "4. Set up camera and spawn point\n" +
                "5. Create cathedral placement markers\n\n" +
                "Continue?",
                "Yes", "Cancel"))
            {
                return;
            }

            Debug.Log("[AutoSceneSetup] Starting Moon 1 automated setup...");

            // Create scene using MoonSceneBuilder logic
            string scenePath = "Assets/_Project/Scenes/Moon1_MagneticMoon.unity";
            
            if (File.Exists(scenePath))
            {
                if (!EditorUtility.DisplayDialog("Scene Exists", 
                    "Moon1_MagneticMoon.unity already exists. Overwrite?", "Yes", "Cancel"))
                {
                    return;
                }
            }

            // Create new scene
            var newScene = EditorSceneManager.NewScene(
                NewSceneSetup.EmptyScene, 
                NewSceneMode.Single);

            // Root GameObject
            GameObject moonRoot = new GameObject("Moon1_MagneticMoon");

            // Sun
            GameObject sun = new GameObject("Sun");
            Light sunLight = sun.AddComponent<Light>();
            sunLight.type = LightType.Directional;
            sunLight.color = new Color(1f, 0.8f, 0.6f); // Golden hour
            sunLight.intensity = 1.2f;
            sunLight.shadows = LightShadows.Soft;
            sun.transform.rotation = Quaternion.Euler(45f, -45f, 0f);
            sun.transform.SetParent(moonRoot.transform);

            // Terrain
            TerrainData terrainData = new TerrainData();
            terrainData.size = new Vector3(500f, 100f, 500f);
            int resolution = terrainData.heightmapResolution;
            float[,] heights = new float[resolution, resolution];
            for (int y = 0; y < resolution; y++)
            {
                for (int x = 0; x < resolution; x++)
                {
                    heights[y, x] = 0.5f; // Flat
                }
            }
            terrainData.SetHeights(0, 0, heights);

            GameObject terrain = Terrain.CreateTerrainGameObject(terrainData);
            terrain.name = "Terrain";
            terrain.transform.SetParent(moonRoot.transform);

            // Reflection Probe
            GameObject probe = new GameObject("Reflection Probe");
            ReflectionProbe rProbe = probe.AddComponent<ReflectionProbe>();
            rProbe.size = new Vector3(500f, 200f, 500f);
            rProbe.center = new Vector3(250f, 50f, 250f);
            rProbe.mode = UnityEngine.Rendering.ReflectionProbeMode.Baked;
            probe.transform.SetParent(moonRoot.transform);

            // Volume (URP)
            GameObject volume = new GameObject("Global Volume");
            try
            {
                var volumeType = System.Type.GetType("UnityEngine.Rendering.Volume, Unity.RenderPipelines.Core.Runtime");
                if (volumeType != null)
                {
                    var vol = volume.AddComponent(volumeType);
                    volumeType.GetProperty("isGlobal").SetValue(vol, true);
                    volumeType.GetProperty("priority").SetValue(vol, 0f);
                }
            }
            catch { }
            volume.transform.SetParent(moonRoot.transform);

            // Camera
            GameObject cam = new GameObject("Main Camera");
            Camera camera = cam.AddComponent<Camera>();
            cam.tag = "MainCamera";
            camera.transform.position = new Vector3(250f, 50f, 150f);
            camera.transform.LookAt(new Vector3(250f, 0f, 250f));
            cam.transform.SetParent(moonRoot.transform);

            // Player Spawn
            GameObject spawn = new GameObject("PlayerSpawnPoint");
            spawn.transform.position = new Vector3(280f, 0f, 280f);
            spawn.tag = "Respawn";
            spawn.transform.SetParent(moonRoot.transform);

            // Cathedral Placement Markers
            GameObject cathedralRoot = new GameObject("CathedralPlacementMarkers");
            cathedralRoot.transform.position = new Vector3(250f, -12f, 250f); // 60% buried
            
            // Foundation marker (16m × 16m grid)
            GameObject foundationMarker = GameObject.CreatePrimitive(PrimitiveType.Cube);
            foundationMarker.name = "Foundation_Marker_16x16m";
            foundationMarker.transform.position = new Vector3(250f, -14f, 250f);
            foundationMarker.transform.localScale = new Vector3(16f, 1f, 16f);
            foundationMarker.GetComponent<Renderer>().material.color = Color.yellow;
            foundationMarker.transform.SetParent(cathedralRoot.transform);

            // Excavation pit marker
            GameObject pitMarker = GameObject.CreatePrimitive(PrimitiveType.Cube);
            pitMarker.name = "ExcavationPit_Marker_50x50m";
            pitMarker.transform.position = new Vector3(250f, -10f, 250f);
            pitMarker.transform.localScale = new Vector3(50f, 0.1f, 50f);
            pitMarker.GetComponent<Renderer>().material.color = Color.cyan;
            pitMarker.transform.SetParent(cathedralRoot.transform);

            // Spire height marker
            GameObject spireMarker = GameObject.CreatePrimitive(PrimitiveType.Cylinder);
            spireMarker.name = "Spire_Height_Marker_20.9m";
            spireMarker.transform.position = new Vector3(250f, 0f, 250f);
            spireMarker.transform.localScale = new Vector3(0.5f, 10.47f, 0.5f); // 20.94m height
            spireMarker.GetComponent<Renderer>().material.color = Color.red;
            spireMarker.transform.SetParent(cathedralRoot.transform);

            cathedralRoot.transform.SetParent(moonRoot.transform);

            // Ambient lighting
            RenderSettings.ambientMode = AmbientMode.Flat;
            RenderSettings.ambientLight = new Color(0.72f, 0.66f, 0.6f); // Warm gray
            RenderSettings.ambientIntensity = 0.8f;

            // Save scene
            EditorSceneManager.SaveScene(newScene, scenePath);

            Debug.Log("[AutoSceneSetup] ✅ Moon1_MagneticMoon.unity created!");
            Debug.Log($"[AutoSceneSetup] Scene saved to: {scenePath}");
            Debug.Log("[AutoSceneSetup] Yellow cube = Foundation (16m × 16m)");
            Debug.Log("[AutoSceneSetup] Cyan plane = Excavation pit (50m × 50m)");
            Debug.Log("[AutoSceneSetup] Red cylinder = Spire height (20.94m)");

            Selection.activeGameObject = moonRoot;

            EditorUtility.DisplayDialog(
                "Moon 1 Scene Created!",
                "Moon1_MagneticMoon.unity is ready!\n\n" +
                "Placement markers:\n" +
                "• Yellow cube = Foundation (16m × 16m)\n" +
                "• Cyan plane = Excavation pit outline\n" +
                "• Red cylinder = Spire height reference\n\n" +
                "Next: Build 18 cathedral prefabs following:\n" +
                "Tools/Phase1/PREFAB_CREATION_CHECKLIST.md",
                "OK"
            );
        }
    }
}