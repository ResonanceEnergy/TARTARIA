using UnityEngine;
using UnityEditor;
using System.IO;
using Tartaria.Data;
using Tartaria.Core.Enums;

namespace Tartaria.Editor
{
    /// <summary>
    /// Data Asset Generator — Creates ItemDatabase + starter items/equipment/enemies.
    /// Menu: Tools → TARTARIA → Generate All Data Assets
    /// 
    /// Creates:
    /// - 1 ItemDatabase.asset
    /// - 10 consumable items
    /// - 10 equipment pieces
    /// - 5 enemy data assets
    /// 
    /// Addresses Agent 1 finding: "Zero data assets created" blocker.
    /// </summary>
    public static class DataAssetGenerator
    {
        const string RESOURCES_PATH = "Assets/_Project/Resources";
        const string ITEMS_PATH = RESOURCES_PATH + "/Items";
        const string EQUIPMENT_PATH = RESOURCES_PATH + "/Equipment";
        const string ENEMIES_PATH = RESOURCES_PATH + "/Enemies";

        [MenuItem("Tools/TARTARIA/Generate All Data Assets", false, 1)]
        public static void GenerateAllDataAssets()
        {
            Debug.Log("[DataAssetGenerator] === BEGIN GENERATION ===");

            int assetsCreated = 0;

            // Ensure directories exist
            EnsureDirectories();

            // 1. Create ItemDatabase if it doesn't exist
            assetsCreated += GenerateItemDatabase();

            // 2. Create 10 consumable items
            assetsCreated += GenerateConsumableItems();

            // 3. Create 10 equipment pieces
            assetsCreated += GenerateEquipmentItems();

            // 4. Create 5 enemy data assets
            assetsCreated += GenerateEnemyData();

            // Refresh AssetDatabase
            AssetDatabase.SaveAssets();
            AssetDatabase.Refresh();

            Debug.Log($"[DataAssetGenerator] === COMPLETE === {assetsCreated} assets created");
            EditorUtility.DisplayDialog("Data Asset Generation", 
                $"Successfully created {assetsCreated} data assets!\n\n" +
                $"• ItemDatabase.asset\n" +
                $"• 10 consumable items\n" +
                $"• 10 equipment pieces\n" +
                $"• 5 enemy data assets\n\n" +
                "Check Assets/_Project/Resources/", "OK");
        }

        static void EnsureDirectories()
        {
            if (!Directory.Exists(RESOURCES_PATH))
                Directory.CreateDirectory(RESOURCES_PATH);
            if (!Directory.Exists(ITEMS_PATH))
                Directory.CreateDirectory(ITEMS_PATH);
            if (!Directory.Exists(EQUIPMENT_PATH))
                Directory.CreateDirectory(EQUIPMENT_PATH);
            if (!Directory.Exists(ENEMIES_PATH))
                Directory.CreateDirectory(ENEMIES_PATH);
        }

        static int GenerateItemDatabase()
        {
            string dbPath = RESOURCES_PATH + "/ItemDatabase.asset";
            
            if (File.Exists(dbPath))
            {
                Debug.LogWarning("[DataAssetGenerator] ItemDatabase.asset already exists — skipping");
                return 0;
            }

            var db = ScriptableObject.CreateInstance<ItemDatabase>();
            AssetDatabase.CreateAsset(db, dbPath);
            Debug.Log($"[DataAssetGenerator] Created ItemDatabase.asset");
            return 1;
        }

        static int GenerateConsumableItems()
        {
            Debug.Log("[DataAssetGenerator] Generating 10 consumable items...");

            var items = new (string id, string name, string desc, int value, float weight, ItemRarity rarity, int stack)[]
            {
                ("health_potion", "Health Potion", "Restores 50 HP. Distilled from aether-infused spring water.", 25, 0.3f, ItemRarity.Common, 20),
                ("mana_potion", "Resonance Elixir", "Restores 30 RS. Crystallized resonance in liquid form.", 30, 0.3f, ItemRarity.Common, 20),
                ("aether_shard", "Aether Shard", "A crystalline fragment pulsing with temporal energy. Essential for resonance rituals.", 150, 0.2f, ItemRarity.Rare, 50),
                ("golem_core", "Golem Core", "Pulsing core extracted from mud golems. Still warm.", 85, 1.2f, ItemRarity.Uncommon, 10),
                ("resonance_crystal", "Resonance Crystal", "Epic-tier crystal that amplifies aether flow by 200%. Used in high-tier upgrades.", 500, 0.5f, ItemRarity.Epic, 5),
                ("repair_kit", "Repair Kit", "Basic tools for field repairs. Contains duct tape and hope.", 30, 0.8f, ItemRarity.Common, 10),
                ("bread", "Artisan Bread", "Freshly baked bread from Echohaven's communal oven. Restores 10 HP.", 5, 0.2f, ItemRarity.Common, 50),
                ("stamina_tonic", "Stamina Tonic", "Restores 25 stamina. Tastes like lightning and regret.", 20, 0.2f, ItemRarity.Common, 20),
                ("antidote", "Antidote Vial", "Cures poison and corruption effects. Keep one handy.", 40, 0.1f, ItemRarity.Uncommon, 10),
                ("phoenix_feather", "Phoenix Feather", "Legendary resurrection item. Revives with 100% HP. Single use.", 2000, 0.1f, ItemRarity.Legendary, 1)
            };

            int created = 0;
            foreach (var (id, name, desc, value, weight, rarity, stack) in items)
            {
                string path = $"{ITEMS_PATH}/{id}.asset";
                if (File.Exists(path))
                {
                    Debug.LogWarning($"[DataAssetGenerator] {id}.asset already exists — skipping");
                    continue;
                }

                var item = ScriptableObject.CreateInstance<ItemData>();
                item.itemID = id;
                item.displayName = name;
                item.description = desc;
                item.value = value;
                item.weight = weight;
                item.rarity = rarity;
                item.stackSize = stack;
                item.category = ItemCategory.Consumable;
                
                AssetDatabase.CreateAsset(item, path);
                Debug.Log($"[DataAssetGenerator] Created {id}.asset");
                created++;
            }

            return created;
        }

        static int GenerateEquipmentItems()
        {
            Debug.Log("[DataAssetGenerator] Generating 10 equipment pieces...");

            var equipment = new (string id, string name, string desc, EquipSlot slot, int str, int agi, int vit, int res, int att, int arm, int value)[]
            {
                ("rusty_sword", "Rusty Sword", "It's seen better days. Still sharp enough to hurt.", EquipSlot.Weapon, 5, 0, 0, 0, 0, 0, 50),
                ("iron_sword", "Iron Sword", "Standard-issue blade. Reliable and balanced.", EquipSlot.Weapon, 12, 3, 0, 0, 0, 0, 150),
                ("resonance_blade", "Resonance Blade", "Hums with aether energy. Deals bonus damage to corrupted enemies.", EquipSlot.Weapon, 18, 5, 0, 5, 3, 0, 450),
                ("leather_armor", "Leather Armor", "Basic protection. Better than nothing.", EquipSlot.Armor, 0, 2, 5, 0, 0, 10, 80),
                ("chainmail_armor", "Chainmail Armor", "Solid mid-tier defense. Heavy but effective.", EquipSlot.Armor, 2, -1, 10, 0, 0, 25, 300),
                ("aether_plate", "Aether Plate Armor", "Legendary armor infused with resonance crystals. Light as a feather.", EquipSlot.Armor, 5, 0, 20, 10, 5, 50, 1500),
                ("iron_helmet", "Iron Helmet", "Protects your thoughts from corruption. And arrows.", EquipSlot.Helmet, 0, 0, 3, 0, 0, 8, 100),
                ("leather_gloves", "Leather Gloves", "Improves grip and dexterity.", EquipSlot.Gloves, 0, 3, 0, 0, 0, 2, 60),
                ("steel_boots", "Steel Boots", "Heavy boots for kicking golems. Movement penalty negated by strength.", EquipSlot.Boots, 2, -1, 2, 0, 0, 5, 120),
                ("resonance_amulet", "Resonance Amulet", "Epic accessory. Boosts all stats and resonance regen.", EquipSlot.Accessory, 3, 3, 5, 10, 8, 0, 800)
            };

            int created = 0;
            foreach (var (id, name, desc, slot, str, agi, vit, res, att, arm, value) in equipment)
            {
                string path = $"{EQUIPMENT_PATH}/{id}.asset";
                if (File.Exists(path))
                {
                    Debug.LogWarning($"[DataAssetGenerator] {id}.asset already exists — skipping");
                    continue;
                }

                var item = ScriptableObject.CreateInstance<EquipmentItemData>();
                item.itemID = id;
                item.itemName = name;
                item.description = desc;
                item.slot = slot;
                item.strengthBonus = str;
                item.agilityBonus = agi;
                item.vitalityBonus = vit;
                item.resonanceBonus = res;
                item.attunementBonus = att;
                item.armorValue = arm;
                // Note: Equipment uses different value system, approximating from item value
                
                AssetDatabase.CreateAsset(item, path);
                Debug.Log($"[DataAssetGenerator] Created {id}.asset (equipment)");
                created++;
            }

            return created;
        }

        static int GenerateEnemyData()
        {
            Debug.Log("[DataAssetGenerator] Generating 5 enemy data assets...");

            var enemies = new (string id, string name, string desc, float hp, float spd, float dmg, float range, float cd, float detect, int xp, float rs, EnemyArchetype arch)[]
            {
                ("mud_golem", "Mud Golem", "Corrupted earth elemental. Slow but durable. Weak to resonance attacks.", 150f, 2.5f, 15f, 3f, 2.5f, 12f, 50, 10f, EnemyArchetype.Tank),
                ("echo_phantom", "Echo Phantom", "Ghostly remnant of a lost soul. Fast and erratic. Phases through walls.", 80f, 5f, 10f, 8f, 1.5f, 20f, 75, 15f, EnemyArchetype.Ranged),
                ("crystal_sentinel", "Crystal Sentinel", "Aether-corrupted guardian construct. High armor, vulnerable to impact damage.", 200f, 3f, 20f, 5f, 3f, 15f, 100, 20f, EnemyArchetype.Elite),
                ("void_wraith", "Void Wraith", "Manifestation of suppressed history. Drains resonance on hit. Dangerous.", 120f, 4f, 18f, 6f, 2f, 18f, 90, 18f, EnemyArchetype.Caster),
                ("corrupted_goliath", "Corrupted Goliath", "Elite-tier giant. Moon 2 mini-boss. Requires coordination to defeat.", 500f, 2f, 35f, 10f, 4f, 25f, 250, 50f, EnemyArchetype.Boss)
            };

            int created = 0;
            foreach (var (id, name, desc, hp, spd, dmg, range, cd, detect, xp, rs, arch) in enemies)
            {
                string path = $"{ENEMIES_PATH}/{id}.asset";
                if (File.Exists(path))
                {
                    Debug.LogWarning($"[DataAssetGenerator] {id}.asset already exists — skipping");
                    continue;
                }

                var enemy = ScriptableObject.CreateInstance<EnemyData>();
                enemy.enemyID = id;
                enemy.displayName = name;
                enemy.description = desc;
                enemy.maxHealth = hp;
                enemy.moveSpeed = spd;
                enemy.attackDamage = dmg;
                enemy.attackRange = range;
                enemy.attackCooldown = cd;
                enemy.detectionRange = detect;
                enemy.xpReward = xp;
                enemy.rsReward = rs;
                enemy.archetype = arch;
                
                // Add spawn moons (Moon 1 for all except Goliath = Moon 2)
                if (id == "corrupted_goliath")
                {
                    enemy.spawnMoons.Add(2);
                }
                else
                {
                    enemy.spawnMoons.Add(1);
                }
                
                // Add basic loot tables
                if (id == "mud_golem")
                {
                    enemy.lootTable.Add(new LootDrop { itemID = "golem_core", dropChance = 0.30f, minQuantity = 1, maxQuantity = 1 });
                    enemy.lootTable.Add(new LootDrop { itemID = "aether_shard", dropChance = 0.10f, minQuantity = 1, maxQuantity = 2 });
                }
                else if (id == "corrupted_goliath")
                {
                    enemy.lootTable.Add(new LootDrop { itemID = "resonance_crystal", dropChance = 0.50f, minQuantity = 1, maxQuantity = 2 });
                    enemy.lootTable.Add(new LootDrop { itemID = "aether_shard", dropChance = 0.80f, minQuantity = 3, maxQuantity = 5 });
                }
                
                AssetDatabase.CreateAsset(enemy, path);
                Debug.Log($"[DataAssetGenerator] Created {id}.asset (enemy)");
                created++;
            }

            return created;
        }

        [MenuItem("Tools/TARTARIA/Populate ItemDatabase from Assets", false, 2)]
        public static void PopulateItemDatabase()
        {
            string dbPath = RESOURCES_PATH + "/ItemDatabase.asset";
            var db = AssetDatabase.LoadAssetAtPath<ItemDatabase>(dbPath);

            if (db == null)
            {
                Debug.LogError("[DataAssetGenerator] ItemDatabase.asset not found! Run 'Generate All Data Assets' first.");
                return;
            }

            // Find all ItemData assets
            string[] guids = AssetDatabase.FindAssets("t:ItemData", new[] { ITEMS_PATH });
            int added = 0;

            foreach (string guid in guids)
            {
                string path = AssetDatabase.GUIDToAssetPath(guid);
                var item = AssetDatabase.LoadAssetAtPath<ItemData>(path);

                if (item != null)
                {
                    db.AddItem(item);
                    added++;
                }
            }

            EditorUtility.SetDirty(db);
            AssetDatabase.SaveAssets();

            Debug.Log($"[DataAssetGenerator] Populated ItemDatabase with {added} items");
            EditorUtility.DisplayDialog("Database Population", 
                $"Added {added} items to ItemDatabase!", "OK");
        }
    }
}
