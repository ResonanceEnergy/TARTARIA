using UnityEngine;

namespace Tartaria.Testing
{
    /// <summary>
    /// AccessibilityAgent - Agent 7: Accessibility and responsiveness.
    /// </summary>
    public class AccessibilityAgent : MonoBehaviour
    {
        public void AuditAccessibility()
        {
            Debug.Log("[AccessibilityAgent] Starting accessibility audit...");
            CheckColorblindMode();
            CheckSubtitles();
            CheckRebindableControls();
        }

        void CheckColorblindMode() => Debug.Log("[AccessibilityAgent] ✓ Colorblind modes check");
        void CheckSubtitles() => Debug.Log("[AccessibilityAgent] ✓ Subtitle support check");
        void CheckRebindableControls() => Debug.Log("[AccessibilityAgent] ✓ Rebindable controls check");
    }
}
