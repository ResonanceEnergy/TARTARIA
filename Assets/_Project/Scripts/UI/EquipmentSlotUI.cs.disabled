using UnityEngine;
using UnityEngine.UI;
using UnityEngine.EventSystems;
using TMPro;
using System;
using Tartaria.Data;
// using Tartaria.Core.Enums; -- moved to Tartaria.Data

namespace Tartaria.UI
{
    /// <summary>
    /// Equipment Slot UI — single equipment slot component with visual feedback.
    /// 
    /// Features:
    /// - Display equipment icon and name
    /// - Glow effect when equipped
    /// - Click/right-click handling
    /// - Hover events for tooltips
    /// - Empty state with slot label
    /// </summary>
    public class EquipmentSlotUI : MonoBehaviour, IPointerClickHandler, IPointerEnterHandler, IPointerExitHandler
    {
        [Header("UI Elements")]
        [SerializeField] Image iconImage;
        [SerializeField] TMP_Text slotLabel;
        [SerializeField] Image glowEffect;
        [SerializeField] Image emptySlotIcon;

        [Header("Colors")]
        [SerializeField] Color normalColor = Color.white;
        [SerializeField] Color highlightColor = new Color(1f, 0.9f, 0.5f);
        [SerializeField] Color glowColor = new Color(0.8f, 0.6f, 1f, 0.5f);

        private EquipSlot _slotType;
        private string _slotName;
        private EquipmentItemData _equipment;
        private bool _isEmpty = true;

        public event Action<EquipSlot> OnSlotClicked;
        public event Action<EquipSlot, bool> OnSlotHovered;
        public event Action<EquipSlot> OnRightClicked;

        public void Initialize(EquipSlot slotType, string slotName)
        {
            _slotType = slotType;
            _slotName = slotName;

            if (slotLabel != null)
                slotLabel.text = slotName;

            ClearSlot();
        }

        public void SetEquipment(EquipmentItemData equipment)
        {
            _equipment = equipment;
            _isEmpty = false;

            if (iconImage != null)
            {
                iconImage.sprite = equipment.icon;
                iconImage.enabled = true;
                iconImage.color = normalColor;
            }

            if (emptySlotIcon != null)
                emptySlotIcon.enabled = false;

            if (glowEffect != null)
            {
                glowEffect.enabled = true;
                glowEffect.color = glowColor;
                StartGlowAnimation();
            }
        }

        public void ClearSlot()
        {
            _equipment = null;
            _isEmpty = true;

            if (iconImage != null)
                iconImage.enabled = false;

            if (emptySlotIcon != null)
                emptySlotIcon.enabled = true;

            if (glowEffect != null)
                glowEffect.enabled = false;
        }

        public EquipmentItemData GetEquipment() => _equipment;
        public bool IsEmpty() => _isEmpty;
        public EquipSlot GetSlotType() => _slotType;

        public void OnPointerClick(PointerEventData eventData)
        {
            if (eventData.button == PointerEventData.InputButton.Right)
            {
                // Right-click to unequip
                if (!_isEmpty)
                    OnRightClicked?.Invoke(_slotType);
            }
            else
            {
                // Left-click
                OnSlotClicked?.Invoke(_slotType);
            }
        }

        public void OnPointerEnter(PointerEventData eventData)
        {
            // Highlight effect
            if (iconImage != null && !_isEmpty)
                iconImage.color = highlightColor;

            OnSlotHovered?.Invoke(_slotType, true);
        }

        public void OnPointerExit(PointerEventData eventData)
        {
            // Remove highlight
            if (iconImage != null)
                iconImage.color = normalColor;

            OnSlotHovered?.Invoke(_slotType, false);
        }

        void StartGlowAnimation()
        {
            // Simple pulsing glow effect
            if (glowEffect != null)
            {
                LeanTween.alpha(glowEffect.rectTransform, 0.2f, 1f)
                    .setLoopPingPong()
                    .setEaseInOutSine();
            }
        }
    }
}
