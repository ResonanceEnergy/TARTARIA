using UnityEngine;
using UnityEngine.UI;
using TMPro;
using Tartaria.Data;
// using Tartaria.Core.Enums; -- moved to Tartaria.Data

namespace Tartaria.UI
{
    /// <summary>
    /// Item Tooltip — rich tooltip display for items and equipment.
    /// 
    /// Features:
    /// - Item name, description, stats
    /// - Rarity color coding (Common=white, Rare=blue, Epic=purple, Legendary=gold, Mythic=red)
    /// - Weight, value, category display
    /// - Equipment stat bonuses
    /// - Smooth fade-in animation (0.5s delay)
    /// - Auto-positioning (avoids screen edges)
    /// 
    /// Usage:
    /// - Call Show(itemData, count, position) to display
    /// - Call Hide() to hide
    /// </summary>
    public class ItemTooltip : MonoBehaviour
    {
        [Header("UI Elements")]
        [SerializeField] CanvasGroup canvasGroup;
        [SerializeField] RectTransform tooltipRect;
        [SerializeField] TMP_Text nameText;
        [SerializeField] TMP_Text rarityText;
        [SerializeField] TMP_Text descriptionText;
        [SerializeField] TMP_Text statsText;
        [SerializeField] TMP_Text footerText;

        [Header("Colors")]
        [SerializeField] Color commonColor = Color.white;
        [SerializeField] Color rareColor = new Color(0.3f, 0.6f, 1f); // Blue
        [SerializeField] Color epicColor = new Color(0.7f, 0.3f, 1f); // Purple
        [SerializeField] Color legendaryColor = new Color(1f, 0.7f, 0.2f); // Gold
        [SerializeField] Color mythicColor = new Color(1f, 0.2f, 0.2f); // Red

        [Header("Settings")]
        [SerializeField] float fadeInDelay = 0.5f;
        [SerializeField] float fadeInDuration = 0.2f;

        private int _fadeInTweenId = -1;
        private bool _isVisible = false;

        void Awake()
        {
            if (canvasGroup == null)
                canvasGroup = GetComponent<CanvasGroup>();

            Hide();
        }

        public void Show(ItemData itemData, int count, Vector3 worldPosition)
        {
            if (itemData == null) return;

            // Cancel any pending fade-in
            if (_fadeInTweenId >= 0)
                LeanTween.cancel(_fadeInTweenId);

            // Build tooltip content
            BuildItemTooltip(itemData, count);

            // Position tooltip
            PositionTooltip(worldPosition);

            // Fade in with delay
            canvasGroup.alpha = 0f;
            gameObject.SetActive(true);

            _fadeInTweenId = LeanTween.alphaCanvas(canvasGroup, 1f, fadeInDuration)
                .setDelay(fadeInDelay)
                .setOnComplete(() => { _isVisible = true; })
                .id;
        }

        public void ShowEquipment(EquipmentItemData equipment, Vector3 worldPosition)
        {
            if (equipment == null) return;

            // Cancel any pending fade-in
            if (_fadeInTweenId >= 0)
                LeanTween.cancel(_fadeInTweenId);

            // Build equipment tooltip
            BuildEquipmentTooltip(equipment);

            // Position tooltip
            PositionTooltip(worldPosition);

            // Fade in with delay
            canvasGroup.alpha = 0f;
            gameObject.SetActive(true);

            _fadeInTweenId = LeanTween.alphaCanvas(canvasGroup, 1f, fadeInDuration)
                .setDelay(fadeInDelay)
                .setOnComplete(() => { _isVisible = true; })
                .id;
        }

        public void Hide()
        {
            if (_fadeInTweenId >= 0)
            {
                LeanTween.cancel(_fadeInTweenId);
                _fadeInTweenId = -1;
            }

            gameObject.SetActive(false);
            _isVisible = false;
        }

        void BuildItemTooltip(ItemData itemData, int count)
        {
            // Name
            if (nameText != null)
            {
                string displayName = itemData.displayName;
                if (count > 1)
                    displayName += $" x{count}";
                nameText.text = $"<b>{displayName}</b>";
                nameText.color = GetRarityColor(itemData.rarity);
            }

            // Rarity
            if (rarityText != null)
            {
                rarityText.text = $"<i>{itemData.rarity}</i> | {itemData.category}";
                rarityText.color = GetRarityColor(itemData.rarity);
            }

            // Description
            if (descriptionText != null)
            {
                descriptionText.text = itemData.description;
            }

            // Stats (empty for basic items)
            if (statsText != null)
            {
                statsText.text = "";
            }

            // Footer (weight, value)
            if (footerText != null)
            {
                footerText.text = $"Weight: {itemData.weight:F1} kg | Value: {itemData.value} RS";
            }
        }

        void BuildEquipmentTooltip(EquipmentItemData equipment)
        {
            // Name
            if (nameText != null)
            {
                nameText.text = $"<b>{equipment.itemName}</b>";
                nameText.color = legendaryColor; // Equipment defaults to legendary color
            }

            // Slot
            if (rarityText != null)
            {
                rarityText.text = $"<i>{equipment.slot}</i>";
                rarityText.color = legendaryColor;
            }

            // Description
            if (descriptionText != null)
            {
                descriptionText.text = equipment.description;
            }

            // Stats
            if (statsText != null)
            {
                string stats = "";
                if (equipment.strengthBonus > 0)
                    stats += $"<color=green>+{equipment.strengthBonus} Strength</color>\n";
                if (equipment.agilityBonus > 0)
                    stats += $"<color=green>+{equipment.agilityBonus} Agility</color>\n";
                if (equipment.vitalityBonus > 0)
                    stats += $"<color=green>+{equipment.vitalityBonus} Vitality</color>\n";
                if (equipment.resonanceBonus > 0)
                    stats += $"<color=green>+{equipment.resonanceBonus} Resonance</color>\n";
                if (equipment.attunementBonus > 0)
                    stats += $"<color=green>+{equipment.attunementBonus} Attunement</color>\n";
                if (equipment.armorValue > 0)
                    stats += $"<color=green>+{equipment.armorValue} Armor</color>\n";

                if (equipment.specialEffects != null && equipment.specialEffects.Length > 0)
                {
                    stats += "\n<b>Special Effects:</b>\n";
                    foreach (var effect in equipment.specialEffects)
                    {
                        stats += $"<color=yellow>• {effect}</color>\n";
                    }
                }

                statsText.text = stats;
            }

            // Footer (empty for equipment)
            if (footerText != null)
            {
                footerText.text = "";
            }
        }

        void PositionTooltip(Vector3 worldPosition)
        {
            if (tooltipRect == null) return;

            // Convert world position to screen space
            Vector2 screenPos = RectTransformUtility.WorldToScreenPoint(Camera.main, worldPosition);

            // Offset to the right and up
            screenPos += new Vector2(20f, 20f);

            // Clamp to screen bounds
            float width = tooltipRect.rect.width;
            float height = tooltipRect.rect.height;

            if (screenPos.x + width > Screen.width)
                screenPos.x = Screen.width - width - 10f;
            if (screenPos.y + height > Screen.height)
                screenPos.y = Screen.height - height - 10f;
            if (screenPos.x < 10f)
                screenPos.x = 10f;
            if (screenPos.y < 10f)
                screenPos.y = 10f;

            tooltipRect.position = screenPos;
        }

        Color GetRarityColor(ItemRarity rarity)
        {
            return rarity switch
            {
                ItemRarity.Common => commonColor,
                ItemRarity.Rare => rareColor,
                ItemRarity.Epic => epicColor,
                ItemRarity.Legendary => legendaryColor,
                ItemRarity.Mythic => mythicColor,
                _ => commonColor
            };
        }
    }
}
