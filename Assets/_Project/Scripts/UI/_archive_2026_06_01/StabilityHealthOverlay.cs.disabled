using UnityEngine;
using UnityEngine.InputSystem;

namespace Tartaria.UI
{
    /// <summary>
    /// Stability Health Overlay — F3-toggleable IMGUI panel showing unified stability metrics.
    /// 
    /// AGENT 1: Live Stability Monitor
    /// 
    /// Complements existing overlays:
    /// - F1: DebugOverlay (game state, RS, entities)
    /// - F2: PerformanceMetricsOverlay (FPS, memory, draw calls)
    /// - F3: StabilityHealthOverlay (crashes, frame drops, stability grade) ← THIS
    /// 
    /// Shows:
    /// - Crashes this session
    /// - Hitches (>100ms frame spikes)
    /// - Frame drops (<30 FPS count)
    /// - Memory pressure
    /// - Budget violations
    /// - Stability grade (A-F)
    /// - Copy to clipboard button for bug reports
    /// 
    /// Zero-dependency (IMGUI only), minimal overhead when hidden.
    /// </summary>
    public class StabilityHealthOverlay : MonoBehaviour
    {
        public static StabilityHealthOverlay Instance { get; private set; }

        bool _visible;
        GUIStyle _boxStyle;
        GUIStyle _labelStyle;
        GUIStyle _headerStyle;
        GUIStyle _buttonStyle;

        // String cache (rebuilt only when visible)
        string _cachedReport = "";
        float _lastUpdateTime;
        const float UPDATE_INTERVAL = 1f; // Update display once per second

        void Awake()
        {
            if (Instance != null && Instance != this)
            {
                Destroy(gameObject);
                return;
            }
            Instance = this;
            DontDestroyOnLoad(gameObject);
        }

        void OnDestroy()
        {
            if (Instance == this)
                Instance = null;
        }

        void Update()
        {
            // Toggle with F3
            if (Keyboard.current != null && Keyboard.current.f3Key.wasPressedThisFrame)
            {
                _visible = !_visible;
                Debug.Log($"[StabilityHealthOverlay] {(_visible ? "Shown" : "Hidden")} (F3)");
            }
        }

        void OnGUI()
        {
            if (!_visible) return;

            // Lazy style init
            if (_boxStyle == null)
            {
                _boxStyle = new GUIStyle(GUI.skin.box)
                {
                    fontSize = 14,
                    alignment = TextAnchor.UpperLeft,
                    richText = true,
                    padding = new RectOffset(10, 10, 10, 10)
                };
            }
            if (_labelStyle == null)
            {
                _labelStyle = new GUIStyle(GUI.skin.label)
                {
                    fontSize = 13,
                    richText = true
                };
            }
            if (_headerStyle == null)
            {
                _headerStyle = new GUIStyle(GUI.skin.label)
                {
                    fontSize = 16,
                    fontStyle = FontStyle.Bold,
                    richText = true
                };
            }
            if (_buttonStyle == null)
            {
                _buttonStyle = new GUIStyle(GUI.skin.button)
                {
                    fontSize = 12
                };
            }

            // Update cached report periodically
            if (Time.realtimeSinceStartup - _lastUpdateTime > UPDATE_INTERVAL)
            {
                _lastUpdateTime = Time.realtimeSinceStartup;
                _cachedReport = BuildReport();
            }

            // Panel dimensions
            float w = 420f;
            float h = 480f;
            float x = Screen.width - w - 10f;
            float y = Screen.height - h - 10f; // Bottom-right corner

            // Background box
            GUI.Box(new Rect(x, y, w, h), "", _boxStyle);

            // Header
            float cx = x + 10f;
            float cy = y + 10f;
            GUI.Label(new Rect(cx, cy, w - 20f, 25f), "<b>STABILITY HEALTH [F3]</b>", _headerStyle);
            cy += 30f;

            // Report content
            GUI.Label(new Rect(cx, cy, w - 20f, h - 90f), _cachedReport, _labelStyle);

            // Copy to Clipboard button
            float buttonWidth = 150f;
            float buttonHeight = 30f;
            float buttonX = x + (w - buttonWidth) / 2f;
            float buttonY = y + h - buttonHeight - 10f;

            if (GUI.Button(new Rect(buttonX, buttonY, buttonWidth, buttonHeight), "Copy to Clipboard", _buttonStyle))
            {
                CopyReportToClipboard();
            }
        }

        string BuildReport()
        {
            if (Tartaria.Core.StabilityMonitor.Instance == null)
                return "<color=red>StabilityMonitor not initialized</color>";

            var monitor = Tartaria.Core.StabilityMonitor.Instance;
            var sb = new System.Text.StringBuilder();

            // Stability grade (color-coded)
            string grade = monitor.GetStabilityGrade();
            Color gradeColor = grade switch
            {
                "A" => new Color(0.3f, 1f, 0.3f), // Bright green
                "B" => new Color(0.7f, 1f, 0.3f), // Yellow-green
                "C" => new Color(1f, 1f, 0.3f),   // Yellow
                "D" => new Color(1f, 0.6f, 0.3f), // Orange
                _ => new Color(1f, 0.3f, 0.3f)    // Red
            };
            string gradeHex = ColorUtility.ToHtmlStringRGB(gradeColor);

            sb.AppendLine($"<b><color=#{gradeHex}>GRADE: {grade}</color></b>");
            sb.AppendLine($"<b>{(monitor.IsStable() ? "<color=lime>STABLE ✓</color>" : "<color=red>UNSTABLE ⚠</color>")}</b>");
            sb.AppendLine();

            // Session info
            float uptime = Tartaria.Core.CrashReporter.GetSessionUptime();
            int uptimeMin = Mathf.FloorToInt(uptime / 60f);
            int uptimeSec = Mathf.FloorToInt(uptime % 60f);
            sb.AppendLine($"Session: {uptimeMin}m {uptimeSec}s");
            sb.AppendLine();

            // Crashes & Hitches (RED if any)
            int crashes = Tartaria.Core.CrashReporter.GetCrashCount();
            int hitches = Tartaria.Core.CrashReporter.GetHitchCount();
            
            if (crashes > 0)
                sb.AppendLine($"<color=red><b>Crashes: {crashes}</b></color>");
            else
                sb.AppendLine($"<color=lime>Crashes: 0</color>");

            if (hitches > 10)
                sb.AppendLine($"<color=orange>Hitches (>100ms): {hitches}</color>");
            else if (hitches > 0)
                sb.AppendLine($"<color=yellow>Hitches (>100ms): {hitches}</color>");
            else
                sb.AppendLine($"<color=lime>Hitches (>100ms): 0</color>");

            sb.AppendLine();

            // Performance
            sb.AppendLine("<b>PERFORMANCE</b>");
            float avgFPS = monitor.GetAverageFPS();
            Color fpsColor = avgFPS >= 60f ? Color.green : (avgFPS >= 30f ? Color.yellow : Color.red);
            string fpsHex = ColorUtility.ToHtmlStringRGB(fpsColor);
            sb.AppendLine($"Avg FPS: <color=#{fpsHex}>{avgFPS:F1}</color>");
            sb.AppendLine($"Min FPS: {monitor.GetMinFPS():F1}");
            sb.AppendLine($"1%-Low: {monitor.Get1PercentLowFPS():F1}");
            
            int frameDrops = monitor.GetFrameDropCount();
            if (frameDrops > 100)
                sb.AppendLine($"<color=orange>Frame Drops (<30fps): {frameDrops}</color>");
            else
                sb.AppendLine($"Frame Drops (<30fps): {frameDrops}");
            
            sb.AppendLine();

            // Memory
            sb.AppendLine("<b>MEMORY</b>");
            long currentMemMB = UnityEngine.Profiling.Profiler.GetTotalAllocatedMemoryLong() / 1048576;
            long peakMemMB = monitor.GetPeakMemoryMB();
            
            Color memColor = peakMemMB > 3500 ? Color.yellow : Color.white;
            string memHex = ColorUtility.ToHtmlStringRGB(memColor);
            sb.AppendLine($"Current: {currentMemMB}MB");
            sb.AppendLine($"Peak: <color=#{memHex}>{peakMemMB}MB</color>");
            sb.AppendLine($"GC Count: {System.GC.CollectionCount(0)}");
            sb.AppendLine();

            // Performance Guard
            if (Tartaria.Core.PerformanceGuard.Instance != null)
            {
                var guard = Tartaria.Core.PerformanceGuard.Instance;
                sb.AppendLine("<b>BUDGET MONITOR</b>");
                sb.AppendLine($"Violations: {guard.BudgetExceededCount}");
                sb.AppendLine($"Worst Frame: {guard.WorstFrameMs:F1}ms");
                
                if (!guard.IsInBudget)
                    sb.AppendLine($"<color=orange>Status: OVER BUDGET</color>");
                else
                    sb.AppendLine($"<color=lime>Status: IN BUDGET</color>");
            }

            return sb.ToString();
        }

        void CopyReportToClipboard()
        {
            if (Tartaria.Core.StabilityMonitor.Instance == null)
            {
                Debug.LogWarning("[StabilityHealthOverlay] StabilityMonitor not available");
                return;
            }

            string fullReport = Tartaria.Core.StabilityMonitor.Instance.GetHealthReport();
            GUIUtility.systemCopyBuffer = fullReport;
            Debug.Log("[StabilityHealthOverlay] Full health report copied to clipboard");
        }

        /// <summary>
        /// Toggle visibility programmatically.
        /// </summary>
        public void Toggle()
        {
            _visible = !_visible;
        }

        /// <summary>
        /// Set visibility programmatically.
        /// </summary>
        public void SetVisible(bool visible)
        {
            _visible = visible;
        }
    }
}
