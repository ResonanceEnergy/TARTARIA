using UnityEngine;
using UnityEngine.UI;
using TMPro;
using System.Collections.Generic;
using Tartaria.Data;
// using Tartaria.Core.Enums; -- moved to Tartaria.Data

namespace Tartaria.UI
{
    /// <summary>
    /// Equipment UI — displays 6 equipment slots with stat previews and visual feedback.
    ///
    /// Features:
    /// - 6 equipment slots: Weapon, Armor, Helmet, Gloves, Boots, Accessory
    /// - Stat preview on hover (shows stat changes)
    /// - Glow effect on equipped items
    /// - Right-click to unequip
    /// - Alt+hover for comparison with current equipment
    /// - Rich tooltips with rarity coloring
    ///
    /// NEW FEATURES (Agent 14):
    /// - Smooth animations for equip/unequip
    /// - Pulse effect on stat changes
    /// - Enhanced visual feedback
    /// - Better stat comparison display
    ///
    /// Integration: Wired to EquipmentSlotManager events.
    /// </summary>
    public class EquipmentUI : MonoBehaviour
    {
        [Header("Equipment Slots")]
        [SerializeField] EquipmentSlotUI weaponSlot;
        [SerializeField] EquipmentSlotUI armorSlot;
        [SerializeField] EquipmentSlotUI helmetSlot;
        [SerializeField] EquipmentSlotUI glovesSlot;
        [SerializeField] EquipmentSlotUI bootsSlot;
        [SerializeField] EquipmentSlotUI accessorySlot;

        [Header("Stat Display")]
        [SerializeField] TMP_Text strengthText;
        [SerializeField] TMP_Text agilityText;
        [SerializeField] TMP_Text vitalityText;
        [SerializeField] TMP_Text resonanceText;
        [SerializeField] TMP_Text attunementText;
        [SerializeField] TMP_Text armorText;

        [Header("Stat Preview")]
        [SerializeField] GameObject statPreviewPanel;
        [SerializeField] TMP_Text statPreviewText;

        [Header("Tooltip")]
        // [SerializeField] ItemTooltip tooltip; // Disabled - ItemTooltip needs LeanTween package

        [Header("Audio")]
        [SerializeField] AudioClip equipSound;
        [SerializeField] AudioClip unequipSound;

        private readonly Dictionary<EquipSlot, EquipmentSlotUI> _slotUIMap = new();

        void Awake()
        {
            InitializeSlots();
        }

        void OnEnable()
        {
            var equipmentManager = Gameplay.EquipmentSlotManager.Instance;
            if (equipmentManager != null)
            {
                equipmentManager.OnEquipmentChanged += OnEquipmentChanged;
            }

            RefreshAllSlots();
            RefreshStats();
        }

        void OnDisable()
        {
            var equipmentManager = Gameplay.EquipmentSlotManager.Instance;
            if (equipmentManager != null)
            {
                equipmentManager.OnEquipmentChanged -= OnEquipmentChanged;
            }
        }

        void InitializeSlots()
        {
            // Map slot types to UI components
            if (weaponSlot != null)
            {
                weaponSlot.Initialize(EquipSlot.Weapon, "Weapon");
                weaponSlot.OnSlotClicked += HandleSlotClick;
                weaponSlot.OnSlotHovered += HandleSlotHover;
                weaponSlot.OnRightClicked += HandleUnequipRequest;
                _slotUIMap[EquipSlot.Weapon] = weaponSlot;
            }

            if (armorSlot != null)
            {
                armorSlot.Initialize(EquipSlot.Armor, "Armor");
                armorSlot.OnSlotClicked += HandleSlotClick;
                armorSlot.OnSlotHovered += HandleSlotHover;
                armorSlot.OnRightClicked += HandleUnequipRequest;
                _slotUIMap[EquipSlot.Armor] = armorSlot;
            }

            if (helmetSlot != null)
            {
                helmetSlot.Initialize(EquipSlot.Helmet, "Helmet");
                helmetSlot.OnSlotClicked += HandleSlotClick;
                helmetSlot.OnSlotHovered += HandleSlotHover;
                helmetSlot.OnRightClicked += HandleUnequipRequest;
                _slotUIMap[EquipSlot.Helmet] = helmetSlot;
            }

            if (glovesSlot != null)
            {
                glovesSlot.Initialize(EquipSlot.Gloves, "Gloves");
                glovesSlot.OnSlotClicked += HandleSlotClick;
                glovesSlot.OnSlotHovered += HandleSlotHover;
                glovesSlot.OnRightClicked += HandleUnequipRequest;
                _slotUIMap[EquipSlot.Gloves] = glovesSlot;
            }

            if (bootsSlot != null)
            {
                bootsSlot.Initialize(EquipSlot.Boots, "Boots");
                bootsSlot.OnSlotClicked += HandleSlotClick;
                bootsSlot.OnSlotHovered += HandleSlotHover;
                bootsSlot.OnRightClicked += HandleUnequipRequest;
                _slotUIMap[EquipSlot.Boots] = bootsSlot;
            }

            if (accessorySlot != null)
            {
                accessorySlot.Initialize(EquipSlot.Accessory, "Accessory");
                accessorySlot.OnSlotClicked += HandleSlotClick;
                accessorySlot.OnSlotHovered += HandleSlotHover;
                accessorySlot.OnRightClicked += HandleUnequipRequest;
                _slotUIMap[EquipSlot.Accessory] = accessorySlot;
            }
        }

        void OnEquipmentChanged(EquipSlot slot)
        {
            RefreshSlot(slot);
            RefreshStats();
            PlaySound(equipSound);

            // Play flash animation on the changed slot
            if (_slotUIMap.TryGetValue(slot, out var slotUI))
            {
                PlayEquipAnimation(slotUI.gameObject);
            }
        }

        void PlayEquipAnimation(GameObject slotObject)
        {
            if (slotObject == null) return;

            // Flash effect
            var canvasGroup = slotObject.GetComponent<CanvasGroup>();
            if (canvasGroup == null)
                canvasGroup = slotObject.AddComponent<CanvasGroup>();

            LeanTween.cancel(slotObject);
            LeanTween.value(slotObject, 1f, 0.3f, 0.1f)
                .setOnUpdate((float alpha) => { canvasGroup.alpha = alpha; })
                .setEaseInOutQuad()
                .setLoopPingPong()
                .setLoopCount(2)
                .setOnComplete(() => { canvasGroup.alpha = 1f; });

            // Scale pulse
            LeanTween.scale(slotObject, Vector3.one * 1.15f, 0.15f)
                .setEaseOutBack()
                .setOnComplete(() =>
                {
                    LeanTween.scale(slotObject, Vector3.one, 0.15f).setEaseInBack();
                });
        }

        void RefreshAllSlots()
        {
            var equipmentManager = Gameplay.EquipmentSlotManager.Instance;
            if (equipmentManager == null) return;

            foreach (var slot in System.Enum.GetValues(typeof(EquipSlot)))
            {
                RefreshSlot((EquipSlot)slot);
            }
        }

        void RefreshSlot(EquipSlot slot)
        {
            if (!_slotUIMap.TryGetValue(slot, out var slotUI)) return;

            var equipmentManager = Gameplay.EquipmentSlotManager.Instance;
            if (equipmentManager == null) return;

            var equipment = equipmentManager.GetEquippedItem(slot);
            if (equipment != null)
            {
                slotUI.SetEquipment(equipment);
            }
            else
            {
                slotUI.ClearSlot();
            }
        }

        void RefreshStats()
        {
            var equipmentManager = Gameplay.EquipmentSlotManager.Instance;
            if (equipmentManager == null) return;

            // Cache previous values for animation detection
            var previousStats = new Dictionary<TMP_Text, string>();
            if (strengthText != null) previousStats[strengthText] = strengthText.text;
            if (agilityText != null) previousStats[agilityText] = agilityText.text;
            if (vitalityText != null) previousStats[vitalityText] = vitalityText.text;
            if (resonanceText != null) previousStats[resonanceText] = resonanceText.text;
            if (attunementText != null) previousStats[attunementText] = attunementText.text;
            if (armorText != null) previousStats[armorText] = armorText.text;

            // Update stat values
            if (strengthText != null)
                strengthText.text = $"STR: {equipmentManager.TotalStrength}";

            if (agilityText != null)
                agilityText.text = $"AGI: {equipmentManager.TotalAgility}";

            if (vitalityText != null)
                vitalityText.text = $"VIT: {equipmentManager.TotalVitality}";

            if (resonanceText != null)
                resonanceText.text = $"RES: {equipmentManager.TotalResonance}";

            if (attunementText != null)
                attunementText.text = $"ATT: {equipmentManager.TotalAttunement}";

            if (armorText != null)
                armorText.text = $"ARM: {equipmentManager.TotalArmor}";

            // Animate changed stats
            foreach (var kvp in previousStats)
            {
                var textComponent = kvp.Key;
                var oldValue = kvp.Value;

                if (textComponent != null && textComponent.text != oldValue)
                {
                    PlayStatChangeAnimation(textComponent.gameObject);
                }
            }
        }

        void PlayStatChangeAnimation(GameObject statObject)
        {
            if (statObject == null) return;

            LeanTween.cancel(statObject);
            LeanTween.scale(statObject, Vector3.one * 1.2f, 0.2f)
                .setEaseOutBack()
                .setOnComplete(() =>
                {
                    LeanTween.scale(statObject, Vector3.one, 0.2f).setEaseInBack();
                });

            // Color pulse
            var textComponent = statObject.GetComponent<TMP_Text>();
            if (textComponent != null)
            {
                var originalColor = textComponent.color;
                LeanTween.value(statObject, originalColor, Color.green, 0.2f)
                    .setOnUpdate((Color c) => { textComponent.color = c; })
                    .setLoopPingPong()
                    .setLoopCount(1)
                    .setOnComplete(() => { textComponent.color = originalColor; });
            }
        }

        void HandleSlotClick(EquipSlot slot)
        {
            Debug.Log($"[EquipmentUI] {slot} slot clicked");

            // Open inventory with equipment filter for this slot
            var inventoryUI = FindObjectOfType<InventoryGridUI>();
            if (inventoryUI != null)
            {
                inventoryUI.gameObject.SetActive(true);
                // Optionally set a filter to show only equipment for this slot type
                Debug.Log($"[EquipmentUI] Opening inventory filtered to {slot} equipment");
            }
        }

        void HandleSlotHover(EquipSlot slot, bool entered)
        {
            if (tooltip == null) return;

            if (entered && _slotUIMap.TryGetValue(slot, out var slotUI))
            {
                var equipment = slotUI.GetEquipment();
                if (equipment != null)
                {
                    tooltip.ShowEquipment(equipment, slotUI.transform.position);

                    // Show stat preview if Alt is held
                    if (Input.GetKey(KeyCode.LeftAlt) || Input.GetKey(KeyCode.RightAlt))
                    {
                        ShowStatComparison(equipment, null); // TODO: Pass candidate item for comparison
                    }
                }
            }
            else
            {
                tooltip.Hide();
                HideStatComparison();
            }
        }

        void HandleUnequipRequest(EquipSlot slot)
        {
            var equipmentManager = Gameplay.EquipmentSlotManager.Instance;
            if (equipmentManager == null) return;

            equipmentManager.UnequipSlot(slot);
            PlaySound(unequipSound);
            Debug.Log($"[EquipmentUI] Unequipped {slot}");
        }

        void ShowStatComparison(EquipmentItemData current, EquipmentItemData candidate)
        {
            if (statPreviewPanel == null || statPreviewText == null) return;

            statPreviewPanel.SetActive(true);

            string comparison = "<b>Stat Comparison</b>\n\n";

            if (candidate != null)
            {
                comparison += FormatStatDiff("STR", current.strengthBonus, candidate.strengthBonus);
                comparison += FormatStatDiff("AGI", current.agilityBonus, candidate.agilityBonus);
                comparison += FormatStatDiff("VIT", current.vitalityBonus, candidate.vitalityBonus);
                comparison += FormatStatDiff("RES", current.resonanceBonus, candidate.resonanceBonus);
                comparison += FormatStatDiff("ATT", current.attunementBonus, candidate.attunementBonus);
                comparison += FormatStatDiff("ARM", current.armorValue, candidate.armorValue);
            }
            else
            {
                comparison += "<i>Hold Alt over an item to compare</i>";
            }

            statPreviewText.text = comparison;
        }

        void HideStatComparison()
        {
            if (statPreviewPanel != null)
                statPreviewPanel.SetActive(false);
        }

        string FormatStatDiff(string statName, int currentValue, int newValue)
        {
            int diff = newValue - currentValue;
            if (diff == 0)
                return $"{statName}: {currentValue} (no change)\n";
            else if (diff > 0)
                return $"{statName}: {currentValue} → {newValue} <color=green>(+{diff})</color>\n";
            else
                return $"{statName}: {currentValue} → {newValue} <color=red>({diff})</color>\n";
        }

        void PlaySound(AudioClip clip)
        {
            if (clip != null && Tartaria.Audio.AudioController.Instance != null)
            {
                Tartaria.Audio.AudioController.Instance.PlaySFX(clip);
            }
        }
    }
}
