using UnityEngine;
using UnityEngine.UI;
using TMPro;
using System.Collections;
using System.Collections.Generic;
using Tartaria.Core;
using Tartaria.Audio;

namespace Tartaria.UI
{
    /// <summary>
    /// Displays UI toast notifications for player rewards and achievements.
    /// Subscribes to: GameEvents.OnBuildingRestored, OnLevelUp, OnItemPickup.
    /// Toast behavior: slide in from top, hold 2s, slide out.
    /// Queues multiple toasts to avoid overlap.
    /// Plays audio stinger on display (via AudioManager).
    /// </summary>
    public class RewardToastController : MonoBehaviour
    {
        [Header("UI References")]
        [SerializeField] private RectTransform _toastContainer;
        [SerializeField] private TextMeshProUGUI _toastText;
        [SerializeField] private Image _toastBackground;
        [SerializeField] private Image _toastIcon;

        [Header("Animation Settings")]
        [SerializeField] private float _slideInDuration = 0.3f;
        [SerializeField] private float _holdDuration = 2f;
        [SerializeField] private float _slideOutDuration = 0.3f;
        [SerializeField] private float _slideDistance = 150f;
        [SerializeField] private AnimationCurve _slideInCurve = AnimationCurve.EaseOut(0f, 0f, 1f, 1f);
        [SerializeField] private AnimationCurve _slideOutCurve = AnimationCurve.EaseIn(0f, 0f, 1f, 1f);

        [Header("Visual Settings")]
        [SerializeField] private Color _rsColor = new Color(1f, 0.84f, 0f, 1f); // Gold
        [SerializeField] private Color _levelUpColor = new Color(0.3f, 1f, 0.3f, 1f); // Green
        [SerializeField] private Color _itemColor = new Color(0.5f, 0.7f, 1f, 1f); // Light blue

        [Header("Audio")]
        [SerializeField] private string _rsStingerSfx = "ui_reward_rs";
        [SerializeField] private string _levelUpStingerSfx = "ui_levelup";
        [SerializeField] private string _itemStingerSfx = "ui_item_pickup";

        // Toast queue
        private Queue<ToastMessage> _toastQueue = new Queue<ToastMessage>();
        private bool _isShowingToast = false;
        private Vector2 _hiddenPosition;
        private Vector2 _visiblePosition;

        private Coroutine _showToastCoroutine;

        void Awake()
        {
            // If no UI references assigned, create procedural toast
            if (_toastContainer == null)
            {
                CreateProceduralToast();
            }

            // Calculate screen positions
            _hiddenPosition = new Vector2(0f, _slideDistance);
            _visiblePosition = Vector2.zero;

            // Start hidden
            _toastContainer.anchoredPosition = _hiddenPosition;
            _toastContainer.gameObject.SetActive(false);
        }

        void OnEnable()
        {
            GameEvents.OnBuildingRestoredTyped += HandleBuildingRestored;
            GameEvents.OnLevelUp += HandleLevelUp;
            GameEvents.OnItemPickup += HandleItemPickup;
        }

        void OnDisable()
        {
            GameEvents.OnBuildingRestoredTyped -= HandleBuildingRestored;
            GameEvents.OnLevelUp -= HandleLevelUp;
            GameEvents.OnItemPickup -= HandleItemPickup;
            
            if (_showToastCoroutine != null)
            {
                StopCoroutine(_showToastCoroutine);
                _showToastCoroutine = null;
            }
        }

        private void CreateProceduralToast()
        {
            // Create toast UI hierarchy
            Canvas canvas = FindAnyObjectByType<Canvas>();
            if (canvas == null)
            {
                Debug.LogError("[RewardToastController] No Canvas found in scene - cannot create toast UI");
                return;
            }

            GameObject toastObj = new GameObject("RewardToast");
            toastObj.transform.SetParent(canvas.transform, false);

            _toastContainer = toastObj.AddComponent<RectTransform>();
            _toastContainer.anchorMin = new Vector2(0.5f, 1f); // Top center
            _toastContainer.anchorMax = new Vector2(0.5f, 1f);
            _toastContainer.pivot = new Vector2(0.5f, 1f);
            _toastContainer.anchoredPosition = new Vector2(0f, -20f); // 20px from top
            _toastContainer.sizeDelta = new Vector2(400f, 80f);

            // Background
            GameObject bgObj = new GameObject("Background");
            bgObj.transform.SetParent(_toastContainer, false);
            _toastBackground = bgObj.AddComponent<Image>();
            _toastBackground.color = new Color(0.1f, 0.1f, 0.1f, 0.9f);
            RectTransform bgRect = bgObj.GetComponent<RectTransform>();
            bgRect.anchorMin = Vector2.zero;
            bgRect.anchorMax = Vector2.one;
            bgRect.sizeDelta = Vector2.zero;

            // Icon (left side)
            GameObject iconObj = new GameObject("Icon");
            iconObj.transform.SetParent(_toastContainer, false);
            _toastIcon = iconObj.AddComponent<Image>();
            RectTransform iconRect = iconObj.GetComponent<RectTransform>();
            iconRect.anchorMin = new Vector2(0f, 0.5f);
            iconRect.anchorMax = new Vector2(0f, 0.5f);
            iconRect.pivot = new Vector2(0.5f, 0.5f);
            iconRect.anchoredPosition = new Vector2(40f, 0f);
            iconRect.sizeDelta = new Vector2(50f, 50f);

            // Text (right of icon)
            GameObject textObj = new GameObject("Text");
            textObj.transform.SetParent(_toastContainer, false);
            _toastText = textObj.AddComponent<TextMeshProUGUI>();
            _toastText.fontSize = 24f;
            _toastText.alignment = TextAlignmentOptions.Left;
            _toastText.color = Color.white;
            RectTransform textRect = textObj.GetComponent<RectTransform>();
            textRect.anchorMin = new Vector2(0f, 0f);
            textRect.anchorMax = new Vector2(1f, 1f);
            textRect.offsetMin = new Vector2(80f, 10f); // Left, Bottom padding
            textRect.offsetMax = new Vector2(-20f, -10f); // Right, Top padding

            Debug.Log("[RewardToastController] Created procedural toast UI");
        }

        private void HandleBuildingRestored(BuildingRestoredEventArgs args)
        {
            string message = $"+{args.rsReward} RS";
            if (args.tuningAccuracy >= 0.9f)
            {
                message += " (Perfect!)";
            }

            QueueToast(new ToastMessage
            {
                text = message,
                color = _rsColor,
                audioStinger = _rsStingerSfx,
                type = ToastType.ResonanceShards
            });
        }

        private void HandleLevelUp(LevelUpEventArgs args)
        {
            string message = $"Level Up! → Lv {args.newLevel}";

            QueueToast(new ToastMessage
            {
                text = message,
                color = _levelUpColor,
                audioStinger = _levelUpStingerSfx,
                type = ToastType.LevelUp
            });
        }

        private void HandleItemPickup(ItemPickupEventArgs args)
        {
            // Format item name (remove prefixes like "item_", convert underscores)
            string displayName = FormatItemName(args.itemId);
            string message = args.count > 1 ? $"{displayName} +{args.count}" : $"{displayName} +1";

            QueueToast(new ToastMessage
            {
                text = message,
                color = _itemColor,
                audioStinger = _itemStingerSfx,
                type = ToastType.ItemPickup
            });
        }

        private string FormatItemName(string itemId)
        {
            // Convert "aether_shard" → "Aether Shard"
            string formatted = itemId.Replace("_", " ");
            formatted = System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(formatted);

            // Remove common prefixes
            formatted = formatted.Replace("Item ", "");
            formatted = formatted.Replace("Pickup ", "");

            return formatted;
        }

        private void QueueToast(ToastMessage message)
        {
            _toastQueue.Enqueue(message);

            // Start showing toasts if not already active
            if (!_isShowingToast)
            {
                if (_showToastCoroutine != null) StopCoroutine(_showToastCoroutine);
                _showToastCoroutine = StartCoroutine(ShowNextToast());
            }
        }

        private IEnumerator ShowNextToast()
        {
            while (_toastQueue.Count > 0)
            {
                _isShowingToast = true;
                ToastMessage message = _toastQueue.Dequeue();

                // Configure toast visuals
                _toastText.text = message.text;
                _toastText.color = message.color;
                if (_toastBackground != null)
                {
                    _toastBackground.color = new Color(message.color.r * 0.2f, message.color.g * 0.2f, message.color.b * 0.2f, 0.9f);
                }

                // Play audio stinger
                PlayAudioStinger(message.audioStinger);

                // Activate container
                _toastContainer.gameObject.SetActive(true);

                // Slide in
                yield return StartCoroutine(AnimateToast(_hiddenPosition, _visiblePosition, _slideInDuration, _slideInCurve));

                // Hold
                yield return new WaitForSeconds(_holdDuration);

                // Slide out
                yield return StartCoroutine(AnimateToast(_visiblePosition, _hiddenPosition, _slideOutDuration, _slideOutCurve));

                // Hide container
                _toastContainer.gameObject.SetActive(false);
            }

            _isShowingToast = false;
        }

        private IEnumerator AnimateToast(Vector2 from, Vector2 to, float duration, AnimationCurve curve)
        {
            float elapsed = 0f;
            while (elapsed < duration)
            {
                elapsed += Time.deltaTime;
                float t = Mathf.Clamp01(elapsed / duration);
                float curveT = curve.Evaluate(t);

                _toastContainer.anchoredPosition = Vector2.Lerp(from, to, curveT);
                yield return null;
            }

            _toastContainer.anchoredPosition = to;
        }

        private void PlayAudioStinger(string sfxName)
        {
            if (string.IsNullOrEmpty(sfxName)) return;

            // Try to find AudioManager singleton
            AudioManager audioManager = FindAnyObjectByType<AudioManager>();
            if (audioManager != null)
            {
                // AudioManager.PlaySFX or similar method
                // Fallback: assume AudioManager has a Play method
                try
                {
                    audioManager.SendMessage("PlaySFX", sfxName, SendMessageOptions.DontRequireReceiver);
                }
                catch
                {
                    // Silent fallback if AudioManager doesn't exist
                }
            }
            else
            {
                // Fallback: use AudioSource if available
                AudioSource audioSource = GetComponent<AudioSource>();
                if (audioSource != null && audioSource.clip != null)
                {
                    audioSource.Play();
                }
            }
        }

        /// <summary>
        /// Public API: Manually queue a custom toast message.
        /// </summary>
        public void ShowCustomToast(string text, Color color, string audioStinger = null)
        {
            QueueToast(new ToastMessage
            {
                text = text,
                color = color,
                audioStinger = audioStinger,
                type = ToastType.Custom
            });
        }

        private class ToastMessage
        {
            public string text;
            public Color color;
            public string audioStinger;
            public ToastType type;
        }

        private enum ToastType
        {
            ResonanceShards,
            LevelUp,
            ItemPickup,
            Custom
        }
    }
}
