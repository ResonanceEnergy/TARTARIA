using UnityEngine;
using UnityEngine.EventSystems;
#if ENABLE_INPUT_SYSTEM
using UnityEngine.InputSystem;
#endif

namespace Tartaria.Input
{
    /// <summary>
    /// SimplePlayerDriver v2 — NUCLEAR bypass for F310 stall.
    ///
    /// Diagnoses + fixes the deep blockers from Unity Manual investigation:
    ///   1. RUNS BEFORE SCENE LOAD setting runInBackground + InputSystem focus modes
    ///   2. AT START: locates Player, KILLS Rigidbody (overrides CC.Move),
    ///      FORCES Time.timeScale = 1, disables competing PlayerInputHandler +
    ///      Moon1HardOverrideDriver components that might be calling cc.Move with bad data
    ///   3. EVERY FRAME logs a tick to console for first 120 frames so we can SEE Update fire
    ///   4. Reads WASD + F310 leftStick + A button DIRECTLY each frame, calls cc.Move()
    ///
    /// [DefaultExecutionOrder(-9999)] ensures this runs BEFORE any other Update.
    /// </summary>
    [DefaultExecutionOrder(-9999)]
    [DisallowMultipleComponent]
    public class SimplePlayerDriver : MonoBehaviour
    {
        static SimplePlayerDriver _instance;
        CharacterController _cc;
        Camera _cam;
        Vector3 _velocity;
        int _frame;
        bool _killedRigidbody, _killedCompetitors, _forcedTimeScale;
        string _statusLine = "(init)";
        GUIStyle _style;

        public float MoveSpeed = 7.5f;
        public float SprintMul = 1.6f;
        public float RotateSpeed = 540f;
        public float Gravity = -22f;

        [RuntimeInitializeOnLoadMethod(RuntimeInitializeLoadType.BeforeSceneLoad)]
        static void EarlyGuard()
        {
            Application.runInBackground = true;
#if ENABLE_INPUT_SYSTEM
            try
            {
                InputSystem.settings.backgroundBehavior =
                    InputSettings.BackgroundBehavior.IgnoreFocus;
                InputSystem.settings.editorInputBehaviorInPlayMode =
                    InputSettings.EditorInputBehaviorInPlayMode.AllDeviceInputAlwaysGoesToGameView;
            }
            catch { }
#endif
            Debug.Log("[SimplePlayerDriver] EarlyGuard fired — runInBackground=true, IgnoreFocus, GameViewInput");
        }

        [RuntimeInitializeOnLoadMethod(RuntimeInitializeLoadType.AfterSceneLoad)]
        static void Bootstrap()
        {
            if (_instance != null && _instance != null && _instance.gameObject != null) return;
            var go = new GameObject("__SimplePlayerDriver");
            DontDestroyOnLoad(go);
            _instance = go.AddComponent<SimplePlayerDriver>();
            Debug.Log("[SimplePlayerDriver] Bootstrap — instance created.");
        }

        void Start()
        {
            AcquirePlayer();
            // Force time to flow
            if (Time.timeScale < 0.5f)
            {
                Debug.LogWarning($"[SimplePlayerDriver] Time.timeScale was {Time.timeScale} — forcing to 1.0");
                Time.timeScale = 1f;
                _forcedTimeScale = true;
            }
            // Clear EventSystem selection — known Unity input thief when a UI Selectable
            // captures keyboard. Safe to no-op if no EventSystem exists.
            try
            {
                if (EventSystem.current != null)
                {
                    var sel = EventSystem.current.currentSelectedGameObject;
                    if (sel != null)
                    {
                        Debug.LogWarning($"[SimplePlayerDriver] EventSystem had selection '{sel.name}' — clearing.");
                        EventSystem.current.SetSelectedGameObject(null);
                    }
                }
            }
            catch { }
        }

        void AcquirePlayer()
        {
            // PREFER the Player-tagged GameObject; fall back to first CC in scene
            CharacterController preferredCC = null;
            var playerTag = GameObject.FindGameObjectWithTag("Player");
            if (playerTag != null) preferredCC = playerTag.GetComponent<CharacterController>();
            if (preferredCC == null)
            {
                // Walk all CCs and pick the one named "Player" or containing "Player"
                var allCCs = FindObjectsByType<CharacterController>(FindObjectsSortMode.None);
                foreach (var c0 in allCCs)
                    if (c0.gameObject.name.Equals("Player", System.StringComparison.OrdinalIgnoreCase) ||
                        c0.gameObject.name.Contains("Player"))
                    { preferredCC = c0; break; }
                if (preferredCC == null && allCCs.Length > 0) preferredCC = allCCs[0];
            }
            _cc = preferredCC;
            _cam = Camera.main;
            if (_cc == null)
            {
                Debug.LogWarning("[SimplePlayerDriver] No CharacterController in scene — driver inert");
                return;
            }
            Debug.Log($"[SimplePlayerDriver] CC acquired on '{_cc.gameObject.name}' at {_cc.transform.position}, enabled={_cc.enabled}");

            // KILL Rigidbody if present (it overrides CC.Move every FixedUpdate)
            var rb = _cc.GetComponent<Rigidbody>();
            if (rb != null && !_killedRigidbody)
            {
                Debug.LogWarning($"[SimplePlayerDriver] Found Rigidbody on Player — isKinematic={rb.isKinematic}, useGravity={rb.useGravity}. Setting isKinematic=true to stop CC.Move conflict.");
                rb.isKinematic = true;
                rb.useGravity = false;
                _killedRigidbody = true;
            }

            // Disable competing PlayerInputHandler (it may be reading garbage and zeroing position)
            var allMBs = _cc.GetComponents<MonoBehaviour>();
            foreach (var mb in allMBs)
            {
                if (mb == null) continue;
                string n = mb.GetType().Name;
                // Don't disable my own type or core needed scripts
                if (n == "SimplePlayerDriver") continue;
                if (n == "PlayerInputHandler" || n == "Moon1HardOverrideDriver" || n == "Moon1GodMode")
                {
                    Debug.LogWarning($"[SimplePlayerDriver] Disabling competing component: {n}");
                    mb.enabled = false;
                    _killedCompetitors = true;
                }
            }

            if (!_cc.enabled) { _cc.enabled = true; Debug.Log("[SimplePlayerDriver] CC was disabled — re-enabled"); }
        }

        void Update()
        {
            _frame++;

            // RACE-FIX: re-acquire CC every frame if it's null OR if the cached one
            // isn't the Player-tagged GameObject. Handles PlayerSpawner.Start
            // running AFTER SimplePlayerDriver.Start. Cheap — just a tag check.
            if (_cc == null || _cc.gameObject == null ||
                (!_cc.gameObject.name.Contains("Player") && _cc.gameObject.tag != "Player"))
            {
                AcquirePlayer();
            }

            // Heartbeat every 60 frames (~1s @ 60fps) so we can SEE Update ticking
            // in the console even if OnGUI overlay is frozen (Editor Pause vs hung).
            if (_frame % 60 == 0)
            {
                string ccPos = _cc != null ? _cc.transform.position.ToString("F2") : "(null)";
                string padName = "(null)";
                Vector2 stk = Vector2.zero;
#if ENABLE_INPUT_SYSTEM
                var p0 = Gamepad.current;
                if (p0 != null) { padName = p0.displayName; stk = p0.leftStick.ReadValue(); }
                bool kbAny = Keyboard.current != null && Keyboard.current.anyKey.isPressed;
#else
                bool kbAny = false;
#endif
                Debug.Log($"[SimplePlayerDriver] HEARTBEAT f={_frame} ts={Time.timeScale:F2} focus={Application.isFocused} cc={ccPos} pad={padName} stick=({stk.x:F2},{stk.y:F2}) kbAny={kbAny}");
            }

            if (_cc == null) return;

            Vector2 move = ReadMove();
            bool sprint = ReadSprint();
            bool interact = ReadInteractEdge();

            Vector3 fwd, right;
            if (_cam != null)
            {
                fwd = Vector3.Scale(_cam.transform.forward, new Vector3(1, 0, 1)).normalized;
                right = _cam.transform.right;
            }
            else { fwd = Vector3.forward; right = Vector3.right; }

            Vector3 dir = fwd * move.y + right * move.x;
            if (dir.sqrMagnitude > 0.01f)
            {
                dir.Normalize();
                float speed = MoveSpeed * (sprint ? SprintMul : 1f);
                Vector3 motion = dir * speed * Time.deltaTime;
                Quaternion want = Quaternion.LookRotation(dir, Vector3.up);
                _cc.transform.rotation = Quaternion.RotateTowards(_cc.transform.rotation, want, RotateSpeed * Time.deltaTime);
                _cc.Move(motion);
            }
            if (_cc.isGrounded) _velocity.y = -0.5f;
            else _velocity.y += Gravity * Time.deltaTime;
            _cc.Move(new Vector3(0, _velocity.y * Time.deltaTime, 0));

            // Heartbeat status (for OnGUI overlay)
            _statusLine = $"f{_frame} mv({move.x:F2},{move.y:F2}) sp={sprint} int={interact}";
        }

        Vector2 ReadMove()
        {
            Vector2 v = Vector2.zero;
#if ENABLE_INPUT_SYSTEM
            var kb = Keyboard.current;
            if (kb != null)
            {
                if (kb.wKey.isPressed || kb.upArrowKey.isPressed)    v.y += 1f;
                if (kb.sKey.isPressed || kb.downArrowKey.isPressed)  v.y -= 1f;
                if (kb.aKey.isPressed || kb.leftArrowKey.isPressed)  v.x -= 1f;
                if (kb.dKey.isPressed || kb.rightArrowKey.isPressed) v.x += 1f;
            }
            var pad = Gamepad.current;
            if (pad != null && v.sqrMagnitude < 0.01f)
            {
                Vector2 stick = pad.leftStick.ReadValue();
                if (stick.sqrMagnitude > 0.0225f) v = stick;
            }
#endif
            if (v.sqrMagnitude > 1f) v.Normalize();
            return v;
        }

        bool ReadSprint()
        {
#if ENABLE_INPUT_SYSTEM
            if (Keyboard.current != null && Keyboard.current.leftShiftKey.isPressed) return true;
            var pad = Gamepad.current;
            if (pad != null)
            {
                if (pad.leftShoulder.isPressed) return true;
                if (pad.rightTrigger.ReadValue() > 0.5f) return true;
            }
#endif
            return false;
        }

        bool _prevInteract;
        bool ReadInteractEdge()
        {
            bool cur = false;
#if ENABLE_INPUT_SYSTEM
            if (Keyboard.current != null && Keyboard.current.eKey.isPressed) cur = true;
            var pad = Gamepad.current;
            if (pad != null && pad.buttonSouth.isPressed) cur = true;
#endif
            bool edge = cur && !_prevInteract;
            _prevInteract = cur;
            if (edge) Debug.Log($"[SimplePlayerDriver] INTERACT pressed at frame {_frame}");
            return edge;
        }

        void OnGUI()
        {
            if (_style == null)
            {
                _style = new GUIStyle(GUI.skin.label);
                _style.fontSize = 14;
                _style.normal.textColor = new Color(0.30f, 1f, 0.50f, 1f);
                _style.fontStyle = FontStyle.Bold;
            }
            GUI.Box(new Rect(8, 350, 380, 160), "");
#if ENABLE_INPUT_SYSTEM
            var kb = Keyboard.current;
            var pad = Gamepad.current;
            string ccName = _cc != null ? _cc.gameObject.name : "(NULL)";
            Vector3 pos = _cc != null ? _cc.transform.position : Vector3.zero;
            Vector2 stick = pad != null ? pad.leftStick.ReadValue() : Vector2.zero;
            bool kbAnyKey = kb != null && kb.anyKey.isPressed;
            // separate engine-tick frame from driver-tick frame so pause vs blocked input is distinguishable
            string s =
                $"[NUCLEAR BYPASS DRIVER v3]\n" +
                $"DriverFrame {_frame}  EngineFrame {Time.frameCount}\n" +
                $"Focus {Application.isFocused}  TS {Time.timeScale:F1}  rt {Time.realtimeSinceStartup:F1}\n" +
                $"CC '{ccName}'  pos ({pos.x:F1},{pos.y:F1},{pos.z:F1})\n" +
                $"KB {(kb!=null?"OK":"NULL")}  AnyKey={kbAnyKey}\n" +
                $"PAD {(pad!=null?"OK("+pad.displayName+")":"NULL")}  Stick ({stick.x:F2},{stick.y:F2})\n" +
                $"RbKilled={_killedRigidbody} CompKilled={_killedCompetitors} TSForced={_forcedTimeScale}\n" +
                $"{_statusLine}";
#else
            string s = "ENABLE_INPUT_SYSTEM not defined";
#endif
            GUI.Label(new Rect(14, 354, 374, 156), s, _style);
        }
    }
}
