using UnityEngine;
#if ENABLE_INPUT_SYSTEM
using UnityEngine.InputSystem;
#endif

namespace Tartaria.Input
{
    /// <summary>
    /// Moon1Lifeline — last-resort input proof.
    ///
    /// 1. Boots in [BeforeSceneLoad] + [AfterSceneLoad]: sets runInBackground, IgnoreFocus,
    ///    AllDeviceInputAlwaysGoesToGameView. Creates __LIFELINE GameObject (DontDestroyOnLoad).
    /// 2. Start: finds Player, KILLS every other MonoBehaviour on it EXCEPT what's whitelisted.
    /// 3. First 180 frames (3s @ 60fps): auto-moves Player +X by 0.05 per frame.
    ///    If you SEE the Player capsule slide right in the Game view, Update is alive
    ///    and the issue is downstream input — not engine pause.
    /// 4. After frame 180: reads Keyboard.current and Gamepad.current DIRECTLY.
    ///    Logs every non-zero input vector loudly.
    /// 5. OnGUI overlay top-left, big text, three colors based on state.
    ///
    /// To use:
    ///   Press Play. Watch the Player capsule for 3 seconds. If it auto-slides right,
    ///   engine is fine. If it doesn't, Editor is paused or Game view has no focus.
    ///   After 3s, press W/A/S/D or F310 left stick. Look at top-left overlay.
    /// </summary>
    [DefaultExecutionOrder(-32000)]
    [DisallowMultipleComponent]
    public class Moon1Lifeline : MonoBehaviour
    {
        static Moon1Lifeline _instance;
        CharacterController _cc;
        int _frame;
        Vector2 _lastInputV;
        string _lastInputSource = "(none)";
        int _disabledCount;
        GUIStyle _bigStyle;

        const int AutoMoveFrames = 180;
        const float AutoMoveSpeed = 3.0f; // m/s

        [RuntimeInitializeOnLoadMethod(RuntimeInitializeLoadType.BeforeSceneLoad)]
        static void Early()
        {
            Application.runInBackground = true;
#if ENABLE_INPUT_SYSTEM
            try
            {
                InputSystem.settings.backgroundBehavior =
                    InputSettings.BackgroundBehavior.IgnoreFocus;
                InputSystem.settings.editorInputBehaviorInPlayMode =
                    InputSettings.EditorInputBehaviorInPlayMode.AllDeviceInputAlwaysGoesToGameView;
            }
            catch { }
#endif
        }

        [RuntimeInitializeOnLoadMethod(RuntimeInitializeLoadType.AfterSceneLoad)]
        static void Boot()
        {
            if (_instance != null) return;
            var go = new GameObject("__LIFELINE");
            DontDestroyOnLoad(go);
            _instance = go.AddComponent<Moon1Lifeline>();
            Debug.Log("[LIFELINE] Boot — instance created (DDoL).");
        }

        void Start()
        {
            // Find Player (tag first, then walk all CCs)
            GameObject player = GameObject.FindGameObjectWithTag("Player");
            if (player == null)
            {
                foreach (var c in FindObjectsByType<CharacterController>(FindObjectsSortMode.None))
                {
                    if (c.gameObject.name.Contains("Player")) { player = c.gameObject; break; }
                }
            }
            if (player == null)
            {
                Debug.LogError("[LIFELINE] No Player found at Start. Will retry in Update.");
                return;
            }
            _cc = player.GetComponent<CharacterController>();
            if (_cc == null) _cc = player.AddComponent<CharacterController>();
            _cc.enabled = true;

            // KILL every MonoBehaviour on the Player except CharacterController, Animator,
            // Audio components. We don't want PlayerInputHandler, SimplePlayerDriver,
            // Moon1HardOverrideDriver, GiantMode, anything else fighting for cc.Move.
            foreach (var mb in player.GetComponents<MonoBehaviour>())
            {
                if (mb == null) continue;
                string n = mb.GetType().Name;
                if (n == "Moon1Lifeline") continue;
                mb.enabled = false;
                _disabledCount++;
            }

            // Force timeScale alive
            if (Time.timeScale < 0.5f) Time.timeScale = 1f;

            // Kill SimplePlayerDriver's bootstrap GameObject too — it lives on its own
            // GameObject (__SimplePlayerDriver) so the per-Player MB sweep won't catch it.
            var spd = GameObject.Find("__SimplePlayerDriver");
            if (spd != null)
            {
                Destroy(spd);
                Debug.LogWarning("[LIFELINE] Killed __SimplePlayerDriver (competing input driver).");
            }

            Debug.Log($"[LIFELINE] Start. Player='{player.name}' disabled={_disabledCount} MBs. CC pos={_cc.transform.position}");
        }

        void Update()
        {
            _frame++;

            // Re-acquire Player if we lost it (it gets respawned by SaveManager etc)
            if (_cc == null || _cc.gameObject == null)
            {
                GameObject p = GameObject.FindGameObjectWithTag("Player");
                if (p != null) _cc = p.GetComponent<CharacterController>();
            }

            // Loud heartbeat every 30 frames so the Console proves Update is alive
            if (_frame % 30 == 0)
            {
                string padInfo = "(null)";
                bool anyKey = false;
#if ENABLE_INPUT_SYSTEM
                var p0 = Gamepad.current;
                if (p0 != null) padInfo = p0.displayName;
                var k0 = Keyboard.current;
                if (k0 != null) anyKey = k0.anyKey.isPressed;
#endif
                string ccPos = _cc != null ? _cc.transform.position.ToString("F2") : "(null)";
                Debug.Log($"[LIFELINE] f={_frame} ts={Time.timeScale:F2} focus={Application.isFocused} cc={ccPos} pad={padInfo} kbAny={anyKey}");
            }

            if (_cc == null) return;

            // PHASE 1 (frames 1..180): auto-move Player +X. If you SEE the capsule
            // slide right, the engine + Update + CC.Move pipeline is alive.
            if (_frame <= AutoMoveFrames)
            {
                _cc.Move(new Vector3(AutoMoveSpeed * Time.deltaTime, -9.81f * Time.deltaTime, 0f));
                if (_frame == AutoMoveFrames)
                    Debug.Log($"[LIFELINE] AUTO-MOVE phase complete. Now accepting input. Final pos={_cc.transform.position}");
                return;
            }

            // PHASE 2 (frame 181+): read input directly
            Vector2 v = Vector2.zero;
            string src = "(none)";
#if ENABLE_INPUT_SYSTEM
            var kb = Keyboard.current;
            if (kb != null)
            {
                if (kb.wKey.isPressed) { v.y += 1f; src = "KB"; }
                if (kb.sKey.isPressed) { v.y -= 1f; src = "KB"; }
                if (kb.aKey.isPressed) { v.x -= 1f; src = "KB"; }
                if (kb.dKey.isPressed) { v.x += 1f; src = "KB"; }
            }
            var pad = Gamepad.current;
            if (pad != null && v.sqrMagnitude < 0.01f)
            {
                Vector2 stick = pad.leftStick.ReadValue();
                if (stick.sqrMagnitude > 0.0225f) { v = stick; src = "PAD"; }
            }
#endif
            if (v.sqrMagnitude > 0.01f)
            {
                if (v.sqrMagnitude > 1f) v.Normalize();
                _lastInputV = v;
                _lastInputSource = src;
                Vector3 motion = new Vector3(v.x, 0, v.y) * 6f * Time.deltaTime;
                _cc.Move(motion + new Vector3(0, -9.81f * Time.deltaTime, 0));
                // Log on transition (avoid spam)
                if (_frame % 30 == 0)
                    Debug.Log($"[LIFELINE] INPUT! src={src} v=({v.x:F2},{v.y:F2}) pos={_cc.transform.position}");
            }
            else
            {
                _cc.Move(new Vector3(0, -9.81f * Time.deltaTime, 0));
            }
        }

        void OnGUI()
        {
            if (_bigStyle == null)
            {
                _bigStyle = new GUIStyle(GUI.skin.label);
                _bigStyle.fontSize = 22;
                _bigStyle.fontStyle = FontStyle.Bold;
            }

            // Color logic: red = no player, yellow = auto-move phase, green = input phase + input detected
            Color color;
            string phase;
            if (_cc == null)        { color = Color.red;    phase = "NO PLAYER"; }
            else if (_frame <= AutoMoveFrames)
            {
                color = new Color(1f, 0.85f, 0.1f);
                phase = $"AUTO-MOVE {_frame}/{AutoMoveFrames} — watch capsule slide right";
            }
            else if (_lastInputV.sqrMagnitude > 0.01f) { color = new Color(0.2f, 1f, 0.4f); phase = $"INPUT OK: {_lastInputSource} ({_lastInputV.x:F2},{_lastInputV.y:F2})"; }
            else                                         { color = new Color(1f, 0.5f, 0.5f); phase = "WAITING FOR INPUT — press W or push stick"; }

            _bigStyle.normal.textColor = color;

            GUI.Box(new Rect(8, 8, 720, 130), "");
#if ENABLE_INPUT_SYSTEM
            var kb = Keyboard.current;
            var pad = Gamepad.current;
            string padTxt = pad != null ? $"OK({pad.displayName})" : "NULL";
            string kbTxt = kb != null ? "OK" : "NULL";
            bool anyKey = kb != null && kb.anyKey.isPressed;
#else
            string padTxt = "DISABLED";
            string kbTxt = "DISABLED";
            bool anyKey = false;
#endif
            Vector3 pos = _cc != null ? _cc.transform.position : Vector3.zero;
            string s =
                $"[LIFELINE]  f={_frame}  engineF={Time.frameCount}  ts={Time.timeScale:F1}  focus={Application.isFocused}\n" +
                $"KB {kbTxt}  AnyKey={anyKey}   PAD {padTxt}\n" +
                $"Player CC pos ({pos.x:F1}, {pos.y:F1}, {pos.z:F1})  killed {_disabledCount} competing MBs\n" +
                $"{phase}";
            GUI.Label(new Rect(14, 14, 714, 124), s, _bigStyle);
        }
    }
}
