using System.Collections;
using UnityEngine;

public class Moon2CassianArrival : MonoBehaviour
{
    [RuntimeInitializeOnLoadMethod(RuntimeInitializeLoadType.AfterSceneLoad)]
    private void OnEnable()
    {
        if (PlayerPrefs.GetInt("TARTARIA_CurrentMoon", 1) >= 2)
        {
            SpawnCassian();
            SpawnLiraelEcho();
            SetupTriggers();
        }
    }

    private void SpawnCassian()
    {
        GameObject cassianPrefab = Resources.Load<GameObject>("Prefabs/Characters/Cassian");
        if (cassianPrefab != null)
        {
            Instantiate(cassianPrefab, new Vector3(-65f, 0.5f, -5f), Quaternion.identity);
        }
        else
        {
            GameObject cassian = GameObject.CreatePrimitive(PrimitiveType.Capsule); // URP-safe
            cassian.transform.SetParent(transform);
            cassian.transform.localScale = new Vector3(0.65f, 1.05f, 0.65f);
            cassian.transform.localPosition = new Vector3(0f, 1f, 0f);
            Destroy(cassian.GetComponent<Collider>());
            // Long coat — slightly larger capsule wrapping it
            GameObject coat = GameObject.CreatePrimitive(PrimitiveType.Capsule); // URP-safe
            coat.transform.SetParent(cassian.transform);
            coat.transform.localScale = new Vector3(0.85f, 1.2f, 0.85f);
            coat.transform.localPosition = new Vector3(0f, 0.95f, 0f);
            Destroy(coat.GetComponent<Collider>());
            // Apply URP — coat: dark gray-blue, body: lighter neutral
            ApplyURP(cassian, new Color(0.42f, 0.36f, 0.32f));
            ApplyURP(coat, new Color(0.18f, 0.20f, 0.26f));
        }
    }

    private void SpawnLiraelEcho()
    {
        GameObject echoPrefab = Resources.Load<GameObject>("Prefabs/Audio/LiraelECHO");
        if (echoPrefab != null)
        {
            Instantiate(echoPrefab, new Vector3(-90f, 5f, 5f), Quaternion.identity);
        }
        else
        {
            // Implement procedural 432 Hz haunting hum generation here
        }
    }

    private void SetupTriggers()
    {
        var cassianCollider = GetComponent<BoxCollider>();
        if (cassianCollider != null)
        {
            cassianCollider.radius = 8f;
            cassianCollider.isTrigger = true;

            var liraelEchoCollider = GameObject.Find("Lirael Echo Collider").GetComponent<BoxCollider>();
            if (liraelEchoCollider != null)
            {
                liraelEchoCollider.radius = 5f;
                liraelEchoCollider.isTrigger = true;
            }
        }

        // Add event listeners for triggers
        cassianCollider.OnEnter.AddListener(OnCassianEnter);
        liraelEchoCollider.OnEnter.AddListener(OnLiraelEchoEnter);
    }

    private void OnCassianEnter(Collider other)
    {
        if (other.CompareTag("Player"))
        {
            ShowBanner("Cassian", "A man in a long coat steps from the shadow. He doesn't smile.");
            StartCoroutine(ShowBannerDelay(6f));
            PlayerPrefs.SetInt("TARTARIA_Moon2_CassianMet", 1);
        }
    }

    private void OnLiraelEchoEnter(Collider other)
    {
        if (other.CompareTag("Player"))
        {
            ShowBanner("Lirael's echo", "The lullaby... 432 Hz... but broken here. Mixed with something else.");
            StartCoroutine(ShowBannerDelay(7f));
        }
    }

    private void ShowBanner(string bannerName, string message)
    {
        // Delegated to ServiceLocator.HUD per CLAUDE.md "no stubs" — real HUD call,
        // not procedural Canvas building that misuses Unity Text API.
        Tartaria.Core.ServiceLocator.HUD?.ShowBanner(bannerName, message, 6f);
    }

    private IEnumerator ShowBannerDelay(float delay)
    {
        yield return new WaitForSeconds(delay);
        Destroy(gameObject);
    }

    private void ApplyURP(GameObject obj, Color color)
    {
        var mat = obj.GetComponent<Renderer>();
        if (mat != null && mat.material != null)
        {
            mat.material.SetColor("_BaseColor", color);
        }
    }
}
