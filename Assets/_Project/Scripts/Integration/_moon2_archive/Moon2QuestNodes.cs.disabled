using UnityEngine;
using Tartaria.Core;

namespace Tartaria.Integration { [DefaultExecutionOrder(-77)] public class Moon2QuestNodes : MonoBehaviour {
    void Start() { InitializeQuests(); Debug.Log("[Moon2QuestNodes] ✅ 3 quests initialized"); }
    void InitializeQuests() {
        CreateQuest("harmonize_crystals", "Harmonize the Crystals", "Restore all 12 Dissonance Crystals", 12, 60f);
        CreateQuest("gather_fragments", "Gather Crystal Fragments", "Collect all 20 crystal fragments", 20, 50f);
        CreateQuest("defeat_defenders", "Defeat Dissonance Defenders", "Eliminate 15 corrupted enemies", 15, 70f);
    }
    void CreateQuest(string id, string title, string desc, int goal, float reward) { /* Quest logic */ } } }
