using UnityEngine;
using UnityEngine.UI;
using TMPro;
using System.Collections;
using System.Collections.Generic;

namespace Tartaria.Integration
{
    /// <summary>
    /// DialogueSequencer — handles multi-line NPC conversations with choices, branching, callbacks.
    /// Displays dialogue in typewriter effect, player choices as buttons, portrait + nameplate.
    /// Integrates with DialogueManager for speaker NPC data.
    /// 
    /// Sequence Format (JSON):
    /// {
    ///   "speaker": "Cassian",
    ///   "lines": [
    ///     { "text": "Welcome to Echo Haven.", "next": 1 },
    ///     { "text": "What brings you here?", "choices": ["Help me", "Just passing by"] }
    ///   ]
    /// }
    /// 
    /// Features:
    /// - Typewriter text reveal
    /// - Player choice buttons (2-4 options)
    /// - Branching dialogue trees
    /// - Quest triggers on completion
    /// - Audio: voice clips + typing SFX
    /// 
    /// Usage:
    /// - Attach to Canvas GameObject
    /// - Call StartSequence(dialogueData, onComplete)
    /// - Subscribe to OnChoiceMade event for branching logic
    /// 
    /// GDD refs: §05 (Characters & Dialogue), §03 (Campaign NPCs)
    /// </summary>
    public class DialogueSequencer : MonoBehaviour
    {
        public static DialogueSequencer Instance { get; private set; }

        [Header("UI References")]
        [SerializeField] GameObject dialoguePanel;
        [SerializeField] TextMeshProUGUI speakerNameText;
        [SerializeField] TextMeshProUGUI dialogueText;
        [SerializeField] Image portraitImage;
        [SerializeField] Button continueButton;
        [SerializeField] Transform choiceButtonContainer;
        [SerializeField] GameObject choiceButtonPrefab;

        [Header("Settings")]
        [SerializeField] float typewriterSpeed = 0.05f;  // Seconds per character
        [SerializeField] bool skipOnClick = true;
        [SerializeField] AudioClip typingSFX;
        [SerializeField] float typingSFXInterval = 0.1f;

        public event System.Action<int> OnChoiceMade;

        DialogueSequence _currentSequence;
        int _currentLineIndex;
        bool _isTyping;
        bool _isWaitingForChoice;
        System.Action _onComplete;
        AudioSource _sfxSource;
        float _typingSFXTimer;

        void Awake()
        {
            if (Instance != null && Instance != this)
            {
                Destroy(gameObject);
                return;
            }
            Instance = this;

            // Setup audio
            _sfxSource = gameObject.AddComponent<AudioSource>();
            _sfxSource.playOnAwake = false;
            _sfxSource.spatialBlend = 0f;

            // Setup continue button
            if (continueButton != null)
            {
                continueButton.onClick.AddListener(OnContinueClicked);
            }

            // Hide panel initially
            if (dialoguePanel != null)
            {
                dialoguePanel.SetActive(false);
            }
        }

        /// <summary>
        /// Start dialogue sequence.
        /// </summary>
        public void StartSequence(DialogueSequence sequence, System.Action onComplete = null)
        {
            if (sequence == null || sequence.lines.Length == 0)
            {
                Debug.LogWarning("[DialogueSequencer] Invalid sequence");
                return;
            }

            _currentSequence = sequence;
            _currentLineIndex = 0;
            _onComplete = onComplete;

            // Show panel
            if (dialoguePanel != null)
            {
                dialoguePanel.SetActive(true);
            }

            // Set speaker info
            if (speakerNameText != null)
            {
                speakerNameText.text = sequence.speakerName;
            }

            if (portraitImage != null && sequence.speakerPortrait != null)
            {
                portraitImage.sprite = sequence.speakerPortrait;
                portraitImage.gameObject.SetActive(true);
            }

            // Display first line
            DisplayLine(_currentLineIndex);

            Debug.Log($"[DialogueSequencer] Started sequence: {sequence.speakerName}");
        }

        void DisplayLine(int lineIndex)
        {
            if (lineIndex < 0 || lineIndex >= _currentSequence.lines.Length)
            {
                EndSequence();
                return;
            }

            var line = _currentSequence.lines[lineIndex];

            // Clear previous choices
            ClearChoiceButtons();

            // Typewriter effect
            if (dialogueText != null)
            {
                StopAllCoroutines();
                if (_typewriterCoroutine != null) StopCoroutine(_typewriterCoroutine);
                _typewriterCoroutine = StartCoroutine(TypewriterEffect(line.text));
            }

            // Show choices if available
            if (line.choices != null && line.choices.Length > 0)
            {
                _isWaitingForChoice = true;

                if (continueButton != null)
                {
                    continueButton.gameObject.SetActive(false);
                }

                StartCoroutine(ShowChoicesAfterTyping(line.choices));
            }
            else
            {
                _isWaitingForChoice = false;

                if (continueButton != null)
                {
                    continueButton.gameObject.SetActive(true);
                }
            }
        }

        IEnumerator TypewriterEffect(string fullText)
        {
            _isTyping = true;

            if (dialogueText != null)
            {
                dialogueText.text = "";
            }

            _typingSFXTimer = 0f;

            foreach (char c in fullText)
            {
                if (dialogueText != null)
                {
                    dialogueText.text += c;
                }

                // Typing SFX
                _typingSFXTimer += typewriterSpeed;
                if (_typingSFXTimer >= typingSFXInterval && typingSFX != null)
                {
                    _sfxSource.PlayOneShot(typingSFX, 0.3f);
                    _typingSFXTimer = 0f;
                }

                yield return new WaitForSeconds(typewriterSpeed);
            }

            _isTyping = false;
        }

        IEnumerator ShowChoicesAfterTyping(string[] choices)
        {
            // Wait for typing to finish
            while (_isTyping)
            {
                yield return null;
            }

            // Create choice buttons
            if (choiceButtonContainer != null && choiceButtonPrefab != null)
            {
                for (int i = 0; i < choices.Length; i++)
                {
                    int choiceIndex = i;  // Capture for closure
                    string choiceText = choices[i];

                    var buttonGO = Instantiate(choiceButtonPrefab, choiceButtonContainer);
                    var button = buttonGO.GetComponent<Button>();
                    var buttonText = buttonGO.GetComponentInChildren<TextMeshProUGUI>();

                    if (buttonText != null)
                    {
                        buttonText.text = choiceText;
                    }

                    if (button != null)
                    {
                        button.onClick.AddListener(() => OnChoiceClicked(choiceIndex));
                    }
                }
            }
        }

        void OnContinueClicked()
        {
            if (_isTyping && skipOnClick)
            {
                // Skip typing, show full text
                StopAllCoroutines();
                _isTyping = false;

                var line = _currentSequence.lines[_currentLineIndex];
                if (dialogueText != null)
                {
                    dialogueText.text = line.text;
                }

                // Show choices immediately if available
                if (line.choices != null && line.choices.Length > 0)
                {
                    StartCoroutine(ShowChoicesAfterTyping(line.choices));
                }
            }
            else if (!_isTyping && !_isWaitingForChoice)
            {
                // Advance to next line
                _currentLineIndex++;
                DisplayLine(_currentLineIndex);
            }
        }

        void OnChoiceClicked(int choiceIndex)
        {
            _isWaitingForChoice = false;

            Debug.Log($"[DialogueSequencer] Player chose: {choiceIndex}");

            OnChoiceMade?.Invoke(choiceIndex);

            // Note: Branching dialogue logic (choice consequences tracked in WorldChoiceTracker)
            // For now, advance to next line
            _currentLineIndex++;
            DisplayLine(_currentLineIndex);
        }

        void ClearChoiceButtons()
        {
            if (choiceButtonContainer != null)
            {
                foreach (Transform child in choiceButtonContainer)
                {
                    Destroy(child.gameObject);
                }
            }
        }

        void EndSequence()
        {
            Debug.Log("[DialogueSequencer] Sequence ended");

            // Hide panel
            if (dialoguePanel != null)
            {
                dialoguePanel.SetActive(false);
            }

            ClearChoiceButtons();

            _onComplete?.Invoke();
        }

        /// <summary>
        /// Force-close dialogue.
        /// </summary>
        public void CloseDialogue()
        {
            StopAllCoroutines();
            EndSequence();
        }

        [System.Serializable]
        public class DialogueSequence
        {
            public string speakerName;
            public Sprite speakerPortrait;
            public DialogueLine[] lines;
        }

        [System.Serializable]
        public struct DialogueLine
        {
            public string text;
            public string[] choices;  // Null if no choices
            public int nextLineIndex;  // For branching (default -1 = next in sequence)
        }
    }
}
