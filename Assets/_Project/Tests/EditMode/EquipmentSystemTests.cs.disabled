using NUnit.Framework;
using UnityEngine;
using Tartaria.Gameplay;

namespace Tartaria.Tests.EditMode
{
    /// <summary>
    /// Unit tests for EquipmentSlotManager - equip, unequip, stat calculation.
    /// Tests the 6-slot equipment system (Weapon, Armor, Helmet, Gloves, Boots, Accessory).
    /// </summary>
    [TestFixture]
    public class EquipmentSystemTests
    {
        GameObject _equipmentGO;
        EquipmentSlotManager _equipment;

        [SetUp]
        public void Setup()
        {
            _equipmentGO = new GameObject("TestEquipment");
            _equipment = _equipmentGO.AddComponent<EquipmentSlotManager>();
            
            // Override singleton
            var instanceField = typeof(EquipmentSlotManager).GetField("Instance", 
                System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Static);
            instanceField?.SetValue(null, _equipment);
        }

        [TearDown]
        public void Teardown()
        {
            if (_equipmentGO != null)
                Object.DestroyImmediate(_equipmentGO);
            
            var instanceField = typeof(EquipmentSlotManager).GetField("Instance", 
                System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Static);
            instanceField?.SetValue(null, null);
        }

        // ═══════════════════════════════════════════════════════════════════
        // Helper Methods
        // ═══════════════════════════════════════════════════════════════════

        EquipmentItem CreateTestWeapon(string id = "test_sword")
        {
            return new EquipmentItem
            {
                itemID = id,
                itemName = "Test Sword",
                slot = EquipmentSlotManager.EquipSlot.Weapon,
                strengthBonus = 10,
                agilityBonus = 5,
                vitalityBonus = 0,
                resonanceBonus = 0,
                attunementBonus = 0,
                armorValue = 0
            };
        }

        EquipmentItem CreateTestArmor(string id = "test_armor")
        {
            return new EquipmentItem
            {
                itemID = id,
                itemName = "Test Armor",
                slot = EquipmentSlotManager.EquipSlot.Armor,
                strengthBonus = 0,
                agilityBonus = 0,
                vitalityBonus = 20,
                resonanceBonus = 5,
                attunementBonus = 0,
                armorValue = 30
            };
        }

        EquipmentItem CreateTestAccessory(string id = "test_ring")
        {
            return new EquipmentItem
            {
                itemID = id,
                itemName = "Test Ring",
                slot = EquipmentSlotManager.EquipSlot.Accessory,
                strengthBonus = 2,
                agilityBonus = 2,
                vitalityBonus = 2,
                resonanceBonus = 2,
                attunementBonus = 2,
                armorValue = 0
            };
        }

        // ═══════════════════════════════════════════════════════════════════
        // Initial State Tests
        // ═══════════════════════════════════════════════════════════════════

        [Test]
        public void EquipmentSlotManager_StartsWithZeroStats()
        {
            Assert.AreEqual(0, _equipment.TotalStrength);
            Assert.AreEqual(0, _equipment.TotalAgility);
            Assert.AreEqual(0, _equipment.TotalVitality);
            Assert.AreEqual(0, _equipment.TotalResonance);
            Assert.AreEqual(0, _equipment.TotalAttunement);
            Assert.AreEqual(0, _equipment.TotalArmor);
        }

        [Test]
        public void EquipmentSlotManager_AllSlotsStartEmpty()
        {
            Assert.IsNull(_equipment.GetEquippedItem(EquipmentSlotManager.EquipSlot.Weapon));
            Assert.IsNull(_equipment.GetEquippedItem(EquipmentSlotManager.EquipSlot.Armor));
            Assert.IsNull(_equipment.GetEquippedItem(EquipmentSlotManager.EquipSlot.Helmet));
            Assert.IsNull(_equipment.GetEquippedItem(EquipmentSlotManager.EquipSlot.Gloves));
            Assert.IsNull(_equipment.GetEquippedItem(EquipmentSlotManager.EquipSlot.Boots));
            Assert.IsNull(_equipment.GetEquippedItem(EquipmentSlotManager.EquipSlot.Accessory));
        }

        // ═══════════════════════════════════════════════════════════════════
        // EquipItem Tests
        // ═══════════════════════════════════════════════════════════════════

        [Test]
        public void EquipItem_ValidItem_EquipsSuccessfully()
        {
            var weapon = CreateTestWeapon();
            bool result = _equipment.EquipItem(EquipmentSlotManager.EquipSlot.Weapon, weapon);
            
            Assert.IsTrue(result, "EquipItem should succeed");
            Assert.AreEqual(weapon, _equipment.GetEquippedItem(EquipmentSlotManager.EquipSlot.Weapon));
        }

        [Test]
        public void EquipItem_UpdatesStats()
        {
            var weapon = CreateTestWeapon();
            _equipment.EquipItem(EquipmentSlotManager.EquipSlot.Weapon, weapon);
            
            Assert.AreEqual(10, _equipment.TotalStrength, "STR should be 10");
            Assert.AreEqual(5, _equipment.TotalAgility, "AGI should be 5");
        }

        [Test]
        public void EquipItem_NullItem_ReturnsFalse()
        {
            bool result = _equipment.EquipItem(EquipmentSlotManager.EquipSlot.Weapon, null);
            Assert.IsFalse(result, "EquipItem should reject null item");
        }

        [Test]
        public void EquipItem_WrongSlot_ReturnsFalse()
        {
            var weapon = CreateTestWeapon();
            
            // Try to equip weapon in armor slot
            bool result = _equipment.EquipItem(EquipmentSlotManager.EquipSlot.Armor, weapon);
            
            Assert.IsFalse(result, "EquipItem should reject item in wrong slot");
            Assert.IsNull(_equipment.GetEquippedItem(EquipmentSlotManager.EquipSlot.Armor));
        }

        [Test]
        public void EquipItem_ReplaceExisting_UnequipsOld()
        {
            var weapon1 = CreateTestWeapon("sword1");
            var weapon2 = CreateTestWeapon("sword2");
            
            _equipment.EquipItem(EquipmentSlotManager.EquipSlot.Weapon, weapon1);
            _equipment.EquipItem(EquipmentSlotManager.EquipSlot.Weapon, weapon2);
            
            var equipped = _equipment.GetEquippedItem(EquipmentSlotManager.EquipSlot.Weapon);
            Assert.AreEqual("sword2", equipped.itemID, "Should equip new weapon");
        }

        [Test]
        public void EquipItem_FiresOnEquipmentChangedEvent()
        {
            bool eventFired = false;
            EquipmentSlotManager.EquipSlot eventSlot = EquipmentSlotManager.EquipSlot.Weapon;

            _equipment.OnEquipmentChanged += (slot) =>
            {
                eventFired = true;
                eventSlot = slot;
            };

            var weapon = CreateTestWeapon();
            _equipment.EquipItem(EquipmentSlotManager.EquipSlot.Weapon, weapon);

            Assert.IsTrue(eventFired, "OnEquipmentChanged event should fire");
            Assert.AreEqual(EquipmentSlotManager.EquipSlot.Weapon, eventSlot);
        }

        // ═══════════════════════════════════════════════════════════════════
        // UnequipSlot Tests
        // ═══════════════════════════════════════════════════════════════════

        [Test]
        public void UnequipSlot_EquippedItem_UnequipsSuccessfully()
        {
            var weapon = CreateTestWeapon();
            _equipment.EquipItem(EquipmentSlotManager.EquipSlot.Weapon, weapon);
            
            bool result = _equipment.UnequipSlot(EquipmentSlotManager.EquipSlot.Weapon);
            
            Assert.IsTrue(result, "UnequipSlot should succeed");
            Assert.IsNull(_equipment.GetEquippedItem(EquipmentSlotManager.EquipSlot.Weapon));
        }

        [Test]
        public void UnequipSlot_UpdatesStats()
        {
            var weapon = CreateTestWeapon();
            _equipment.EquipItem(EquipmentSlotManager.EquipSlot.Weapon, weapon);
            
            Assert.AreEqual(10, _equipment.TotalStrength);
            
            _equipment.UnequipSlot(EquipmentSlotManager.EquipSlot.Weapon);
            
            Assert.AreEqual(0, _equipment.TotalStrength, "Stats should reset to 0");
        }

        [Test]
        public void UnequipSlot_EmptySlot_ReturnsFalse()
        {
            bool result = _equipment.UnequipSlot(EquipmentSlotManager.EquipSlot.Weapon);
            Assert.IsFalse(result, "UnequipSlot should fail on empty slot");
        }

        // ═══════════════════════════════════════════════════════════════════
        // Stat Calculation Tests
        // ═══════════════════════════════════════════════════════════════════

        [Test]
        public void StatCalculation_MultipleItems_SumsCorrectly()
        {
            var weapon = CreateTestWeapon();
            var armor = CreateTestArmor();
            var accessory = CreateTestAccessory();
            
            _equipment.EquipItem(EquipmentSlotManager.EquipSlot.Weapon, weapon);
            _equipment.EquipItem(EquipmentSlotManager.EquipSlot.Armor, armor);
            _equipment.EquipItem(EquipmentSlotManager.EquipSlot.Accessory, accessory);
            
            // Weapon: STR 10, AGI 5
            // Armor: VIT 20, RES 5, ARM 30
            // Accessory: STR 2, AGI 2, VIT 2, RES 2, ATT 2
            Assert.AreEqual(12, _equipment.TotalStrength, "Total STR should be 12");
            Assert.AreEqual(7, _equipment.TotalAgility, "Total AGI should be 7");
            Assert.AreEqual(22, _equipment.TotalVitality, "Total VIT should be 22");
            Assert.AreEqual(7, _equipment.TotalResonance, "Total RES should be 7");
            Assert.AreEqual(2, _equipment.TotalAttunement, "Total ATT should be 2");
            Assert.AreEqual(30, _equipment.TotalArmor, "Total ARM should be 30");
        }

        [Test]
        public void StatCalculation_UnequipOne_RecalculatesCorrectly()
        {
            var weapon = CreateTestWeapon();  // STR 10
            var accessory = CreateTestAccessory();  // STR 2
            
            _equipment.EquipItem(EquipmentSlotManager.EquipSlot.Weapon, weapon);
            _equipment.EquipItem(EquipmentSlotManager.EquipSlot.Accessory, accessory);
            
            Assert.AreEqual(12, _equipment.TotalStrength);
            
            _equipment.UnequipSlot(EquipmentSlotManager.EquipSlot.Weapon);
            
            Assert.AreEqual(2, _equipment.TotalStrength, "Should only have accessory STR");
        }

        // ═══════════════════════════════════════════════════════════════════
        // GetEquippedItem Tests
        // ═══════════════════════════════════════════════════════════════════

        [Test]
        public void GetEquippedItem_EquippedSlot_ReturnsItem()
        {
            var weapon = CreateTestWeapon();
            _equipment.EquipItem(EquipmentSlotManager.EquipSlot.Weapon, weapon);
            
            var retrieved = _equipment.GetEquippedItem(EquipmentSlotManager.EquipSlot.Weapon);
            
            Assert.AreEqual(weapon, retrieved);
            Assert.AreEqual("test_sword", retrieved.itemID);
        }

        [Test]
        public void GetEquippedItem_EmptySlot_ReturnsNull()
        {
            var retrieved = _equipment.GetEquippedItem(EquipmentSlotManager.EquipSlot.Helmet);
            Assert.IsNull(retrieved);
        }

        // ═══════════════════════════════════════════════════════════════════
        // UnequipAll Tests
        // ═══════════════════════════════════════════════════════════════════

        [Test]
        public void UnequipAll_RemovesAllEquipment()
        {
            var weapon = CreateTestWeapon();
            var armor = CreateTestArmor();
            var accessory = CreateTestAccessory();
            
            _equipment.EquipItem(EquipmentSlotManager.EquipSlot.Weapon, weapon);
            _equipment.EquipItem(EquipmentSlotManager.EquipSlot.Armor, armor);
            _equipment.EquipItem(EquipmentSlotManager.EquipSlot.Accessory, accessory);
            
            _equipment.UnequipAll();
            
            Assert.IsNull(_equipment.GetEquippedItem(EquipmentSlotManager.EquipSlot.Weapon));
            Assert.IsNull(_equipment.GetEquippedItem(EquipmentSlotManager.EquipSlot.Armor));
            Assert.IsNull(_equipment.GetEquippedItem(EquipmentSlotManager.EquipSlot.Accessory));
        }

        [Test]
        public void UnequipAll_ResetsAllStats()
        {
            var weapon = CreateTestWeapon();
            var armor = CreateTestArmor();
            
            _equipment.EquipItem(EquipmentSlotManager.EquipSlot.Weapon, weapon);
            _equipment.EquipItem(EquipmentSlotManager.EquipSlot.Armor, armor);
            
            Assert.Greater(_equipment.TotalStrength, 0);
            Assert.Greater(_equipment.TotalVitality, 0);
            
            _equipment.UnequipAll();
            
            Assert.AreEqual(0, _equipment.TotalStrength);
            Assert.AreEqual(0, _equipment.TotalAgility);
            Assert.AreEqual(0, _equipment.TotalVitality);
            Assert.AreEqual(0, _equipment.TotalResonance);
            Assert.AreEqual(0, _equipment.TotalAttunement);
            Assert.AreEqual(0, _equipment.TotalArmor);
        }

        // ═══════════════════════════════════════════════════════════════════
        // EquipSlot Enum Tests
        // ═══════════════════════════════════════════════════════════════════

        [Test]
        public void EquipSlot_EnumValues_Defined()
        {
            Assert.IsTrue(System.Enum.IsDefined(typeof(EquipmentSlotManager.EquipSlot), 
                EquipmentSlotManager.EquipSlot.Weapon));
            Assert.IsTrue(System.Enum.IsDefined(typeof(EquipmentSlotManager.EquipSlot), 
                EquipmentSlotManager.EquipSlot.Armor));
            Assert.IsTrue(System.Enum.IsDefined(typeof(EquipmentSlotManager.EquipSlot), 
                EquipmentSlotManager.EquipSlot.Helmet));
            Assert.IsTrue(System.Enum.IsDefined(typeof(EquipmentSlotManager.EquipSlot), 
                EquipmentSlotManager.EquipSlot.Gloves));
            Assert.IsTrue(System.Enum.IsDefined(typeof(EquipmentSlotManager.EquipSlot), 
                EquipmentSlotManager.EquipSlot.Boots));
            Assert.IsTrue(System.Enum.IsDefined(typeof(EquipmentSlotManager.EquipSlot), 
                EquipmentSlotManager.EquipSlot.Accessory));
        }

        [Test]
        public void EquipSlot_HasSixSlots()
        {
            var slotCount = System.Enum.GetValues(typeof(EquipmentSlotManager.EquipSlot)).Length;
            Assert.AreEqual(6, slotCount, "Should have exactly 6 equipment slots");
        }
    }
}
