        #endregion

        #region Helper Methods

        static int CreateItem(ref int skipped, string id, string displayName, string description,
            ItemCategory category, ItemRarity rarity, int stackSize, float weight, int value)
        {
            string path = $"{ItemPath}{id}.asset";
            
            if (AssetDatabase.LoadAssetAtPath<ItemData>(path) != null)
            {
                skipped++;
                Debug.Log($"[ItemDatabasePopulator] Skipped existing: {id}");
                return 0;
            }

            var item = ScriptableObject.CreateInstance<ItemData>();
            item.itemID = id;
            item.displayName = displayName;
            item.description = description;
            item.category = category;
            item.rarity = rarity;
            item.stackSize = stackSize;
            item.weight = weight;
            item.value = value;

            AssetDatabase.CreateAsset(item, path);
            Debug.Log($"[ItemDatabasePopulator] Created: {id}");
            return 1;
        }

        static int CreateEquipment(ref int skipped, string id, string displayName, string description,
            EquipSlot slot, int strengthBonus, int agilityBonus, int vitalityBonus, int resonanceBonus,
            int attunementBonus, int armorValue, float weight, int value, ItemRarity rarity,
            string[] specialEffects = null)
        {
            string path = $"{EquipPath}{id}.asset";
            
            if (AssetDatabase.LoadAssetAtPath<EquipmentItemData>(path) != null)
            {
                skipped++;
                Debug.Log($"[ItemDatabasePopulator] Skipped existing: {id}");
                return 0;
            }

            var equip = ScriptableObject.CreateInstance<EquipmentItemData>();
            equip.itemID = id;
            equip.itemName = displayName;
            equip.description = description;
            equip.slot = slot;
            equip.strengthBonus = strengthBonus;
            equip.agilityBonus = agilityBonus;
            equip.vitalityBonus = vitalityBonus;
            equip.resonanceBonus = resonanceBonus;
            equip.attunementBonus = attunementBonus;
            equip.armorValue = armorValue;

            // Store weight/value in customData as JSON (EquipmentItemData doesn't have these fields directly)
            var metadata = new { weight, value, rarity = rarity.ToString() };
            equip.description = $"{description}\n\nWeight: {weight}kg | Value: {value}g | Rarity: {rarity}";
            
            if (specialEffects != null && specialEffects.Length > 0)
            {
                equip.specialEffects = specialEffects;
            }

            AssetDatabase.CreateAsset(equip, path);
            Debug.Log($"[ItemDatabasePopulator] Created: {id}");
            return 1;
        }

        static void WireToDatabase()
        {
            var db = AssetDatabase.LoadAssetAtPath<ItemDatabase>(DbPath);
            if (db == null)
            {
                Debug.LogError("[ItemDatabasePopulator] ItemDatabase not found at " + DbPath);
                return;
            }

            // NOTE: ItemDatabase.items is private, so we can't directly modify it via editor script
            // The database will need to be wired manually OR we need to expose AddItem() as public
            // For now, log instructions for manual wiring
            
            Debug.Log("[ItemDatabasePopulator] ⚠️ MANUAL STEP REQUIRED:");
            Debug.Log("1. Select Assets/_Project/Resources/ItemDatabase.asset");
            Debug.Log("2. In Inspector, click 'Auto-Populate from Assets' button");
            Debug.Log("3. Or manually add items to the 'Items' list");
            
            EditorUtility.DisplayDialog("Manual Wiring Required",
                "Assets created successfully!\n\n" +
                "NEXT STEP:\n" +
                "1. Select ItemDatabase.asset in Resources/\n" +
                "2. Click 'Auto-Populate from Assets' in Inspector\n\n" +
                "This will wire all items into the database.",
                "OK");
        }

        #endregion
    }
}
