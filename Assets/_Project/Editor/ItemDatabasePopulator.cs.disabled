            // Accessories (3 items)
            count += CreateEquipment(ref skipped, "bronze_ring", "Bronze Ring", 
                "Simple band that resonates faintly.", EquipSlot.Accessory,
                strengthBonus: 3, agilityBonus: 3, vitalityBonus: 3, resonanceBonus: 3, 
                attunementBonus: 3, armorValue: 0,
                weight: 0.05f, value: 50, rarity: ItemRarity.Uncommon);
                
            count += CreateEquipment(ref skipped, "resonance_amulet", "Resonance Amulet", 
                "Amplifies aetheric abilities.", EquipSlot.Accessory,
                strengthBonus: 0, agilityBonus: 0, vitalityBonus: 0, resonanceBonus: 10, 
                attunementBonus: 0, armorValue: 0,
                weight: 0.1f, value: 90, rarity: ItemRarity.Rare,
                specialEffects: new[] { "+8% ability damage" });
                
            count += CreateEquipment(ref skipped, "berserker_belt", "Berserker Belt", 
                "Grants fury in combat.", EquipSlot.Accessory,
                strengthBonus: 8, agilityBonus: 0, vitalityBonus: 0, resonanceBonus: 0, 
                attunementBonus: 0, armorValue: 0,
                weight: 0.5f, value: 85, rarity: ItemRarity.Rare,
