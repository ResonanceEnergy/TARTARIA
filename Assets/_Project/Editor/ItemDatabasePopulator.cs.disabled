            // Weapons (3 items)
            count += CreateEquipment(ref skipped, "rusty_sword", "Rusty Sword", 
                "Worn blade from a forgotten soldier.", EquipSlot.Weapon,
                strengthBonus: 0, agilityBonus: 0, vitalityBonus: 0, resonanceBonus: 0, 
                attunementBonus: 0, armorValue: 5,
                weight: 2.0f, value: 15, rarity: ItemRarity.Common);
                
            count += CreateEquipment(ref skipped, "iron_blade", "Iron Blade", 
                "Reliable weapon forged from Old World steel.", EquipSlot.Weapon,
                strengthBonus: 3, agilityBonus: 0, vitalityBonus: 0, resonanceBonus: 0, 
                attunementBonus: 0, armorValue: 12,
                weight: 3.5f, value: 80, rarity: ItemRarity.Uncommon);
                
            count += CreateEquipment(ref skipped, "resonant_staff", "Resonant Staff", 
                "Crystal-tipped staff attuned to aetheric frequencies.", EquipSlot.Weapon,
                strengthBonus: 0, agilityBonus: 0, vitalityBonus: 0, resonanceBonus: 15, 
                attunementBonus: 0, armorValue: 8,
                weight: 2.0f, value: 120, rarity: ItemRarity.Rare,
                specialEffects: new[] { "+10% spell damage" });

            // Armor (4 items)
            count += CreateEquipment(ref skipped, "travelers_vest", "Traveler's Vest", 
                "Simple leather protection for new adventurers.", EquipSlot.Armor,
                strengthBonus: 0, agilityBonus: 0, vitalityBonus: 0, resonanceBonus: 0, 
                attunementBonus: 0, armorValue: 8,
                weight: 2.0f, value: 20, rarity: ItemRarity.Common);
                
            count += CreateEquipment(ref skipped, "iron_chestplate", "Iron Chestplate", 
                "Heavy plating salvaged from golem frames.", EquipSlot.Armor,
                strengthBonus: 0, agilityBonus: 0, vitalityBonus: 5, resonanceBonus: 0, 
                attunementBonus: 0, armorValue: 18,
                weight: 8.0f, value: 100, rarity: ItemRarity.Uncommon);
                
            count += CreateEquipment(ref skipped, "crystal_robes", "Crystal Robes", 
