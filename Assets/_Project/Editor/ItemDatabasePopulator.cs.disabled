using UnityEngine;
using UnityEditor;
using System.Collections.Generic;
using System.Linq;
using Tartaria.Data;
using Tartaria.Core.Enums;

namespace Tartaria.Editor
{
    /// <summary>
    /// AGENT 2: ItemDatabase & Asset Creation System
    /// 
    /// Generates 40 complete item/equipment assets:
    /// - 20 Consumables (health, mana, buffs, food, utility)
    /// - 10 Equipment (weapons, armor, accessories)
    /// - 10 Materials (common + rare crafting)
    /// 
    /// Menu: Tartaria > Build Assets > Item Database (Complete)
    /// 
    /// Features:
    /// - Skip existing assets (safe re-run)
    /// - Auto-wire to ItemDatabase
    /// - Progress reporting
    /// - Validation checks
    /// </summary>
    public static class ItemDatabasePopulator
    {
        const string ItemPath = "Assets/_Project/Resources/Items/";
        const string EquipPath = "Assets/_Project/Resources/Equipment/";
        const string DbPath = "Assets/_Project/Resources/ItemDatabase.asset";

        [MenuItem("Tartaria/Build Assets/Item Database (Complete)", priority = 300)]
        public static void PopulateDatabase()
        {
            PopulateDatabaseInternal(showDialog: true);
        }

        /// <summary>
        /// Batchmode-compatible execution entry point.
        /// Call via: Unity.exe -batchmode -executeMethod Tartaria.Editor.ItemDatabasePopulator.ExecuteBatchMode
        /// </summary>
        public static void ExecuteBatchMode()
        {
            PopulateDatabaseInternal(showDialog: false);
            UnityEditor.EditorApplication.Exit(0);
        }

        static void PopulateDatabaseInternal(bool showDialog)
        {
            Debug.Log("[ItemDatabasePopulator] Starting item creation...");
            
            EnsureFolders();
            
            int created = 0;
            int skipped = 0;

            // PHASE 2: CONSUMABLES (20 items)
            created += CreateConsumables(ref skipped);
            
            // PHASE 3: EQUIPMENT (10 items)
            created += CreateEquipment(ref skipped);
            
            // PHASE 4: MATERIALS (10 items)
            created += CreateMaterials(ref skipped);

            // PHASE 5: WIRE TO DATABASE
            WireToDatabase();

            AssetDatabase.SaveAssets();
            AssetDatabase.Refresh();

            Debug.Log($"[ItemDatabasePopulator] ✅ COMPLETE — {created} created, {skipped} skipped, {created + skipped} total");
            
            if (showDialog)
            {
                EditorUtility.DisplayDialog("Item Database Complete",
                    $"Created: {created}\nSkipped (already exist): {skipped}\nTotal: {created + skipped}",
                    "OK");
            }
        }

        static void EnsureFolders()
        {
            if (!AssetDatabase.IsValidFolder(ItemPath))
                AssetDatabase.CreateFolder("Assets/_Project/Resources", "Items");
            if (!AssetDatabase.IsValidFolder(EquipPath))
                AssetDatabase.CreateFolder("Assets/_Project/Resources", "Equipment");
        }

        #region Consumables (20 items)

        static int CreateConsumables(ref int skipped)
        {
            int count = 0;
            
            // Health/Mana (6 items)
            count += CreateItem(ref skipped, "health_potion_minor", "Minor Health Potion", 
                "Restores 25 HP. Basic healing.", ItemCategory.Consumable, ItemRarity.Common,
                stackSize: 20, weight: 0.1f, value: 10);
                
            count += CreateItem(ref skipped, "health_potion", "Health Potion", 
                "Restores 50 HP. Standard healing.", ItemCategory.Consumable, ItemRarity.Uncommon,
                stackSize: 20, weight: 0.2f, value: 25);
                
            count += CreateItem(ref skipped, "health_potion_greater", "Greater Health Potion", 
                "Restores 100 HP. Strong healing.", ItemCategory.Consumable, ItemRarity.Rare,
                stackSize: 20, weight: 0.3f, value: 60);
                
            count += CreateItem(ref skipped, "mana_crystal_minor", "Minor Mana Crystal", 
                "Restores 25 Mana. Basic energy.", ItemCategory.Consumable, ItemRarity.Common,
                stackSize: 20, weight: 0.1f, value: 15);
                
            count += CreateItem(ref skipped, "mana_crystal", "Mana Crystal", 
                "Restores 50 Mana. Standard energy.", ItemCategory.Consumable, ItemRarity.Uncommon,
                stackSize: 20, weight: 0.2f, value: 35);
                
            count += CreateItem(ref skipped, "mana_crystal_greater", "Greater Mana Crystal", 
                "Restores 100 Mana. Strong energy.", ItemCategory.Consumable, ItemRarity.Rare,
                stackSize: 20, weight: 0.3f, value: 75);

            // Buffs (4 items)
            count += CreateItem(ref skipped, "resonance_boost_scroll", "Resonance Boost Scroll", 
                "+20% damage for 120 seconds.", ItemCategory.Consumable, ItemRarity.Rare,
                stackSize: 5, weight: 0.05f, value: 50);
                
            count += CreateItem(ref skipped, "defenders_tonic", "Defender's Tonic", 
                "+15 armor for 180 seconds.", ItemCategory.Consumable, ItemRarity.Uncommon,
                stackSize: 5, weight: 0.2f, value: 40);
                
            count += CreateItem(ref skipped, "swiftness_elixir", "Swiftness Elixir", 
                "+25% movement speed for 90 seconds.", ItemCategory.Consumable, ItemRarity.Uncommon,
                stackSize: 5, weight: 0.15f, value: 45);
                
            count += CreateItem(ref skipped, "lucky_charm", "Lucky Charm", 
                "+10% loot quality for 300 seconds.", ItemCategory.Consumable, ItemRarity.Epic,
                stackSize: 5, weight: 0.1f, value: 80);

            // Food (5 items)
            count += CreateItem(ref skipped, "crystal_berry", "Crystal Berry", 
                "+10 HP regen per 5 seconds for 30 seconds. Sweet and refreshing.", ItemCategory.Consumable, ItemRarity.Common,
                stackSize: 50, weight: 0.05f, value: 3);
                
            count += CreateItem(ref skipped, "smoked_fungus", "Smoked Fungus", 
                "+5 HP, +5 Mana. Earthy flavor.", ItemCategory.Consumable, ItemRarity.Common,
                stackSize: 50, weight: 0.1f, value: 5);
                
            count += CreateItem(ref skipped, "travelers_ration", "Traveler's Ration", 
                "+25 HP over 60 seconds. Sustenance for long journeys.", ItemCategory.Consumable, ItemRarity.Common,
                stackSize: 20, weight: 0.3f, value: 8);
                
            count += CreateItem(ref skipped, "echohaven_bread", "Echohaven Bread", 
                "+15 HP, removes 1 debuff. Baked fresh.", ItemCategory.Consumable, ItemRarity.Uncommon,
                stackSize: 20, weight: 0.2f, value: 12);
                
            count += CreateItem(ref skipped, "resonant_stew", "Resonant Stew", 
                "+50 HP, +25 Mana, +5% all stats for 180 seconds. Hearty meal.", ItemCategory.Consumable, ItemRarity.Rare,
                stackSize: 10, weight: 0.5f, value: 35);

            // Utility (5 items)
            count += CreateItem(ref skipped, "teleport_crystal", "Teleport Crystal", 
                "Return to last campfire. One-time use.", ItemCategory.Consumable, ItemRarity.Epic,
                stackSize: 5, weight: 0.1f, value: 100);
                
            count += CreateItem(ref skipped, "repair_kit", "Repair Kit", 
                "Restore 50% equipment durability.", ItemCategory.Consumable, ItemRarity.Uncommon,
                stackSize: 10, weight: 0.5f, value: 20);
                
            count += CreateItem(ref skipped, "lockpick", "Lockpick", 
                "Open locked chests. Requires steady hands.", ItemCategory.Consumable, ItemRarity.Common,
                stackSize: 20, weight: 0.02f, value: 5);
                
            count += CreateItem(ref skipped, "resonance_detector", "Resonance Detector", 
                "Highlight nearby secrets for 60 seconds.", ItemCategory.Consumable, ItemRarity.Rare,
                stackSize: 5, weight: 0.1f, value: 75);
                
            count += CreateItem(ref skipped, "camp_beacon", "Camp Beacon", 
