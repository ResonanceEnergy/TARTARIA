        #endregion

        #region Materials (10 items)

        static int CreateMaterials(ref int skipped)
        {
            int count = 0;

            // Common (5 items)
            count += CreateItem(ref skipped, "iron_ore", "Iron Ore", 
                "Raw metal for smithing.", ItemCategory.Material, ItemRarity.Common,
                stackSize: 99, weight: 0.5f, value: 2);
                
            count += CreateItem(ref skipped, "crystal_shard", "Crystal Shard", 
                "Shimmering fragment of resonance crystal.", ItemCategory.Material, ItemRarity.Common,
                stackSize: 99, weight: 0.1f, value: 5);
                
            count += CreateItem(ref skipped, "leather_scrap", "Leather Scrap", 
                "Salvaged hide for armor crafting.", ItemCategory.Material, ItemRarity.Common,
                stackSize: 99, weight: 0.2f, value: 3);
                
            count += CreateItem(ref skipped, "wood_plank", "Wood Plank", 
                "Cut timber for construction.", ItemCategory.Material, ItemRarity.Common,
                stackSize: 99, weight: 0.3f, value: 1);
                
            count += CreateItem(ref skipped, "resonance_dust", "Resonance Dust", 
                "Fine powder from crushed aether shards.", ItemCategory.Material, ItemRarity.Common,
                stackSize: 99, weight: 0.05f, value: 8);

            // Rare (5 items)
            count += CreateItem(ref skipped, "echohaven_stone", "Echohaven Stone", 
                "Quarried from sacred architecture.", ItemCategory.Material, ItemRarity.Rare,
                stackSize: 20, weight: 0.8f, value: 50);
                
            count += CreateItem(ref skipped, "ancient_alloy", "Ancient Alloy", 
                "Pre-cataclysm metal blend. Unknown composition.", ItemCategory.Material, ItemRarity.Rare,
                stackSize: 20, weight: 1.0f, value: 75);
                
            count += CreateItem(ref skipped, "pure_crystal", "Pure Crystal", 
                "Flawless resonance gem.", ItemCategory.Material, ItemRarity.Epic,
                stackSize: 20, weight: 0.3f, value: 100);
                
            count += CreateItem(ref skipped, "resonant_core", "Resonant Core", 
