        #endregion

        #region Helper Methods

        static int CreateQuest(ref int skipped, int moonId, int orderIndex, string questId, string title, string description,
            QuestCategory category, QuestObjective[] objectives = null, bool isMainQuest = false,
            string[] prerequisites = null, int xpReward = 0, float rsReward = 0, string[] itemRewards = null)
        {
            string moonFolder = $"{QuestPath}Moon{moonId}";
            string path = $"{moonFolder}/{questId}.asset";
            
            if (AssetDatabase.LoadAssetAtPath<QuestData>(path) != null)
            {
                skipped++;
                Debug.Log($"[QuestDatabasePopulator] Skipped existing: {questId}");
                return 0;
            }

            var quest = ScriptableObject.CreateInstance<QuestData>();
            quest.questId = questId;
            quest.displayName = title;
            quest.description = description;
            quest.moonId = moonId;
            quest.category = category;
            quest.isMainQuest = isMainQuest;
            
            // Objectives
            if (objectives != null && objectives.Length > 0)
                quest.objectives = objectives;
            else
                quest.objectives = new QuestObjective[] { CreateObjective("Complete quest", QuestObjectiveType.CompleteMiniGame, "generic", 1) };

            // Prerequisites
            quest.prerequisiteQuestIds = prerequisites ?? System.Array.Empty<string>();
            
            // Rewards
            quest.xpReward = xpReward;
            quest.rsReward = rsReward;
            quest.itemRewards = itemRewards ?? System.Array.Empty<string>();

            // Quest flow defaults
            quest.autoActivateOnPrerequisites = true;
            quest.canAbandon = !isMainQuest; // Main quests can't be abandoned
            quest.isRepeatable = false;

            AssetDatabase.CreateAsset(quest, path);
            Debug.Log($"[QuestDatabasePopulator] Created: {questId} ({title})");
            return 1;
        }

        static QuestObjective CreateObjective(string description, QuestObjectiveType type, string targetId, int count)
        {
            return new QuestObjective
            {
                description = description,
                type = type,
                targetId = targetId,
                targetCount = count
            };
        }

        static void WireToDatabase()
        {
            var db = AssetDatabase.LoadAssetAtPath<QuestDatabase>(DbPath);
            if (db == null)
            {
                Debug.LogWarning($"[QuestDatabasePopulator] QuestDatabase not found at {DbPath} — skipping auto-wiring.");
                Debug.LogWarning("Create a QuestDatabase asset at the specified path or wire quests manually.");
                return;
            }

            Debug.Log("[QuestDatabasePopulator] ⚠️ MANUAL STEP REQUIRED:");
            Debug.Log("1. Select Assets/_Project/Resources/QuestDatabase.asset");
            Debug.Log("2. In Inspector, add quest assets from Assets/_Project/Data/Quests/Moon1-4/ folders");
            Debug.Log("3. Or implement QuestDatabase.AddQuest() public method for auto-wiring");
            
            EditorUtility.DisplayDialog("Manual Wiring Required",
                "Quest assets created successfully!\n\n" +
                "NEXT STEP:\n" +
                "1. Select QuestDatabase.asset in Resources/\n" +
                "2. Add quest assets from Data/Quests/Moon1-4/ folders\n\n" +
                "This will wire all 120 quests into the database.",
                "OK");
        }

        #endregion
    }
}
