using UnityEngine;
using UnityEditor;
using System.Collections.Generic;
using Tartaria.Data;
using Tartaria.Core;
using Tartaria.Core.Enums;

namespace Tartaria.Editor
{
    /// <summary>
    /// AGENT 4: Quest Database & Asset Creation System
    /// 
    /// Generates 120 complete quest assets for Moons 1-4:
    /// - Moon 1 (Echohaven): 30 quests (1 main + 29 side)
    /// - Moon 2 (Lunar Resonance): 30 quests (1 main + 29 side)
    /// - Moon 3 (Orphan Train): 30 quests (1 main + 29 side)
    /// - Moon 4 (Agricultural Inversion): 30 quests (1 main + 29 side)
    /// 
    /// Menu: Tartaria > Build Assets > Quest Database (Moon 1-4)
    /// 
    /// Features:
    /// - Skip existing assets (safe re-run)
    /// - Auto-wire to QuestDatabase
    /// - Progress reporting
    /// - Lore-accurate from docs/03_CAMPAIGN_13_MOONS.md
    /// </summary>
    public static class QuestDatabasePopulator
    {
        const string QuestPath = "Assets/_Project/Data/Quests/";
        const string DbPath = "Assets/_Project/Resources/QuestDatabase.asset";

        [MenuItem("Tartaria/Build Assets/Quest Database (Moon 1-4)", priority = 301)]
        public static void PopulateQuests()
        {
            PopulateQuestsInternal(showDialog: true);
        }

        /// <summary>
        /// Batchmode-compatible execution entry point.
        /// Call via: Unity.exe -batchmode -executeMethod Tartaria.Editor.QuestDatabasePopulator.ExecuteBatchMode
        /// </summary>
        public static void ExecuteBatchMode()
        {
            PopulateQuestsInternal(showDialog: false);
            UnityEditor.EditorApplication.Exit(0);
        }

        static void PopulateQuestsInternal(bool showDialog)
        {
            Debug.Log("[QuestDatabasePopulator] Starting quest creation for Moons 1-4...");
            
            EnsureFolders();
            
            int created = 0;
            int skipped = 0;

            // MOON 1: ECHOHAVEN (30 quests)
            created += CreateMoon1Quests(ref skipped);
            
            // MOON 2: LUNAR RESONANCE (30 quests)
            created += CreateMoon2Quests(ref skipped);
            
            // MOON 3: ORPHAN TRAIN (30 quests)
            created += CreateMoon3Quests(ref skipped);
            
            // MOON 4: AGRICULTURAL INVERSION (30 quests)
            created += CreateMoon4Quests(ref skipped);

            // WIRE TO DATABASE
            WireToDatabase();

            AssetDatabase.SaveAssets();
            AssetDatabase.Refresh();

            Debug.Log($"[QuestDatabasePopulator] ✅ COMPLETE — {created} created, {skipped} skipped, {created + skipped} total");
            
            if (showDialog)
            {
                EditorUtility.DisplayDialog("Quest Database Complete",
                    $"Created: {created}\nSkipped (already exist): {skipped}\nTotal: {created + skipped}\n\n" +
                    "Quests organized by Moon folders.",
                    "OK");
            }
        }

        static void EnsureFolders()
        {
            if (!AssetDatabase.IsValidFolder("Assets/_Project/Data"))
                AssetDatabase.CreateFolder("Assets/_Project", "Data");
            if (!AssetDatabase.IsValidFolder(QuestPath))
                AssetDatabase.CreateFolder("Assets/_Project/Data", "Quests");
            
            // Create Moon subfolders
            for (int i = 1; i <= 4; i++)
            {
                string moonFolder = $"{QuestPath}Moon{i}";
                if (!AssetDatabase.IsValidFolder(moonFolder))
                    AssetDatabase.CreateFolder(QuestPath.TrimEnd('/'), $"Moon{i}");
            }
        }

