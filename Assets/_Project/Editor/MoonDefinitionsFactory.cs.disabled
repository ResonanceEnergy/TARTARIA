#if UNITY_EDITOR
using System.IO;
using UnityEditor;
using UnityEditor.SceneManagement;
using UnityEngine;
using Tartaria.Integration;
using Tartaria.Core;
using Tartaria.Data;

namespace Tartaria.Editor
{
    /// <summary>
    /// Authors per-Moon design data:
    ///   1. Generates 13 MoonDefinition ScriptableObject assets in
    ///      Assets/_Project/Config/Moons/ (one per moon).
    ///   2. Generates 12 stub QuestDefinition assets (Moons 2-13) in
    ///      Assets/_Project/Config/Quests/ — Moon 1 already has Quest_AwakenStarDome.
    ///   3. Opens each Moon stub scene and attaches a MoonRuntimeBootstrapper
    ///      with the matching MoonDefinition wired in.
    ///
    /// Idempotent: existing assets are updated in place.
    /// Wired into OneClickBuild as Phase 9j8/9j9.
    /// </summary>
    public static class MoonDefinitionsFactory
    {
        const string MoonsConfigDir  = "Assets/_Project/Config/Moons";
        const string QuestsConfigDir = "Assets/_Project/Config/Quests";

        // Per-moon design metadata (mechanic, companion, headline, whisper).
        // Mirrors docs/03_CAMPAIGN_13_MOONS.md and docs/03C_MOON_MECHANICS_DETAILED.md.
        struct DesignBeat
        {
            public string headline;
            public string whisper;
            public MoonMechanic mechanic;
            public MoonCompanion companion;
            public float rsRequirement;
        }

        static readonly DesignBeat[] Beats =
        {
            new(){ headline="Magnetic Moon: Awakening",            whisper="The song was never lost. It was only buried.",                  mechanic=MoonMechanic.Excavation,      companion=MoonCompanion.Milo,      rsRequirement=0    },
            new(){ headline="Lunar Moon: Shadow & Purge",          whisper="Listen for the dissonance. Where it grows, the song breaks.",  mechanic=MoonMechanic.DissonancePurge, companion=MoonCompanion.Cassian,   rsRequirement=10   },
            new(){ headline="Electric Moon: Compassion & Rails",   whisper="Children rode these rails before the silence came.",           mechanic=MoonMechanic.OrphanTrain,     companion=MoonCompanion.Lirael,    rsRequirement=25   },
            new(){ headline="Self-Existing Moon: Precision",       whisper="The fort remembers every stone you set in its bones.",         mechanic=MoonMechanic.FortifyDefense,  companion=MoonCompanion.Milo,      rsRequirement=40   },
            new(){ headline="Overtone Moon: Amplification",        whisper="Sing one note. The white city will sing the rest.",            mechanic=MoonMechanic.Amplification,   companion=MoonCompanion.Lirael,    rsRequirement=55   },
            new(){ headline="Rhythmic Moon: Pipe Organ Requiem",   whisper="The organ is older than language. Older than stone.",          mechanic=MoonMechanic.OrganRequiem,    companion=MoonCompanion.Anastasia, rsRequirement=70   },
            new(){ headline="Resonant Moon: Giant's Awakening",    whisper="Your bloodline was carved into mountains.",                    mechanic=MoonMechanic.GiantMode,       companion=MoonCompanion.Korath,    rsRequirement=85   },
            new(){ headline="Galactic Moon: The Airship Armada",   whisper="The sky belonged to us. It will again.",                       mechanic=MoonMechanic.AirshipArmada,   companion=MoonCompanion.Thorne,    rsRequirement=100  },
            new(){ headline="Solar Moon: The Ley Line Prophecy",   whisper="Every prophecy was a memory written backwards.",               mechanic=MoonMechanic.LeyProphecy,     companion=MoonCompanion.Cassian,   rsRequirement=120  },
            new(){ headline="Planetary Moon: The Living Grid",     whisper="The world is one instrument. You are its breath.",             mechanic=MoonMechanic.LivingGrid,      companion=MoonCompanion.Lirael,    rsRequirement=140  },
            new(){ headline="Spectral Moon: Veil Between Worlds",  whisper="The dead are not gone. They sing on a frequency you forgot.",  mechanic=MoonMechanic.SpectralVeil,    companion=MoonCompanion.Lirael,    rsRequirement=160  },
            new(){ headline="Crystal Moon: Planetary Bell-Tower Ring", whisper="One ring will be heard on every continent at once.",       mechanic=MoonMechanic.BellTower,       companion=MoonCompanion.Anastasia, rsRequirement=185  },
            new(){ headline="Cosmic Moon: True Timeline Convergence", whisper="Now. Strike the bell that was always meant to ring.",      mechanic=MoonMechanic.Convergence,     companion=MoonCompanion.Lirael,    rsRequirement=210  },
        };

        [MenuItem("TARTARIA/Integration/Generate Moon Definitions + Quests + Bootstrappers")]
        public static void RunMenu() => Run();

        public static int Run()
        {
            EnsureFolder(MoonsConfigDir);
            EnsureFolder(QuestsConfigDir);

            int defsTouched   = AuthorMoonDefinitions();
            int questsTouched = AuthorMoonQuests();
            int scenesTouched = AttachBootstrappers();

            AssetDatabase.SaveAssets();
            AssetDatabase.Refresh();

            Debug.Log($"[MoonDefinitionsFactory] {defsTouched} definitions, "
                      + $"{questsTouched} quest stubs, {scenesTouched} scenes wired.");
            return defsTouched + questsTouched + scenesTouched;
        }

        // ── 1. MoonDefinition assets ─────────────────────────────

        static int AuthorMoonDefinitions()
        {
            int n = 0;
            foreach (var moon in MoonScenesFactory.Moons)
            {
                var beat = Beats[moon.number - 1];
                string path = $"{MoonsConfigDir}/Moon{moon.number:D2}_{moon.sceneName}.asset";
                var def = AssetDatabase.LoadAssetAtPath<MoonDefinition>(path);
                if (def == null)
                {
                    def = ScriptableObject.CreateInstance<MoonDefinition>();
                    AssetDatabase.CreateAsset(def, path);
                }
                def.number         = moon.number;
                def.sceneName      = moon.sceneName;
                def.zoneName       = moon.zoneName;
                def.headline       = beat.headline;
                def.aetherWhisper  = beat.whisper;
                def.mechanic       = beat.mechanic;
                def.companion      = beat.companion;
                def.fogColor       = moon.fogHigh;
                def.fogDensity     = moon.fogDensity;
                def.ambientHigh    = moon.ambientHigh;
                def.ambientLow     = moon.ambientLow;
                def.spawnPos       = moon.spawnPos;
                def.rsRequirement  = beat.rsRequirement;
                def.questId        = moon.number == 1 ? "AwakenStarDome" : $"Moon{moon.number:D2}_Awaken";
                EditorUtility.SetDirty(def);
                n++;
            }
            return n;
        }

        // ── 2. Per-moon quest stubs ──────────────────────────────

        static int AuthorMoonQuests()
        {
            int n = 0;
            foreach (var moon in MoonScenesFactory.Moons)
            {
                if (moon.number == 1) continue; // existing Quest_AwakenStarDome.asset
                var beat = Beats[moon.number - 1];
                string id   = $"Moon{moon.number:D2}_Awaken";
                string path = $"{QuestsConfigDir}/Quest_{id}.asset";

                var q = AssetDatabase.LoadAssetAtPath<QuestDefinition>(path);
                if (q == null)
                {
                    q = ScriptableObject.CreateInstance<QuestDefinition>();
                    AssetDatabase.CreateAsset(q, path);
                }
                q.questId       = id;
                q.displayName   = $"Moon {moon.number}: {moon.zoneName}";
                q.description   = beat.headline + "\n\n" + beat.whisper;
                q.isMainQuest   = true;
                q.autoActivate  = false;
                q.rsRequirement = beat.rsRequirement;
                q.rsReward      = 15f + moon.number * 2f;
                EditorUtility.SetDirty(q);
                n++;
            }
            return n;
        }

        // ── 3. Attach MoonRuntimeBootstrapper to each moon stub scene ──

        static int AttachBootstrappers()
        {
            int n = 0;
            foreach (var moon in MoonScenesFactory.Moons)
            {
                if (moon.number == 1) continue; // Echohaven uses its own bootstrapper chain
                string scenePath = MoonScenesFactory.ScenePathFor(moon);
                if (!File.Exists(scenePath)) continue;

                string defPath = $"{MoonsConfigDir}/Moon{moon.number:D2}_{moon.sceneName}.asset";
                var def = AssetDatabase.LoadAssetAtPath<MoonDefinition>(defPath);
                if (def == null) continue;

                var scene = EditorSceneManager.OpenScene(scenePath, OpenSceneMode.Single);

                var existing = Object.FindFirstObjectByType<MoonRuntimeBootstrapper>();
                MoonRuntimeBootstrapper bootstrapper;
                if (existing != null)
                {
                    bootstrapper = existing;
                }
                else
                {
                    var go = new GameObject("MoonRuntimeBootstrapper");
                    bootstrapper = go.AddComponent<MoonRuntimeBootstrapper>();
                }
                bootstrapper.definition = def;
                EditorUtility.SetDirty(bootstrapper);

                // Mechanic activator (combat/excavation/resonance per moon)
                var activator = Object.FindFirstObjectByType<MoonMechanicActivator>();
                if (activator == null)
                {
                    var actGO = new GameObject("MoonMechanicActivator");
                    activator = actGO.AddComponent<MoonMechanicActivator>();
                }
                activator.definition = def;
                EditorUtility.SetDirty(activator);

                // Day-4: per-moon companion stand-in (named NPC + 3-line greeting).
                var companion = Object.FindFirstObjectByType<MoonCompanionSpawner>();
                if (companion == null)
                {
                    var compGO = new GameObject("MoonCompanionSpawner");
                    companion = compGO.AddComponent<MoonCompanionSpawner>();
                }
                companion.definition = def;
                EditorUtility.SetDirty(companion);

                EditorSceneManager.MarkSceneDirty(scene);
                EditorSceneManager.SaveScene(scene, scenePath);
                n++;
            }
            return n;
        }

        static void EnsureFolder(string path)
        {
            if (string.IsNullOrEmpty(path) || AssetDatabase.IsValidFolder(path)) return;
            var parent = Path.GetDirectoryName(path).Replace('\\', '/');
            EnsureFolder(parent);
            AssetDatabase.CreateFolder(parent, Path.GetFileName(path));
        }
    }
}
#endif
