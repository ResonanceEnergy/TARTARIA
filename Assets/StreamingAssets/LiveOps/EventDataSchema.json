{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TARTARIA Live Events Schema",
  "description": "JSON schema for defining daily quests, seasonal events, and content updates",
  "version": "1.0",
  
  "definitions": {
    "DailyQuest": {
      "type": "object",
      "required": ["questId", "displayName", "type", "startTimeISO", "endTimeISO", "objectives", "rewards"],
      "properties": {
        "questId": {
          "type": "string",
          "pattern": "^DAILY_[0-9]{4}_[0-9]{2}_[0-9]{2}_[0-9]{3}$",
          "description": "Unique quest identifier (format: DAILY_YYYY_MM_DD_NNN)",
          "example": "DAILY_2026_05_24_001"
        },
        "displayName": {
          "type": "string",
          "maxLength": 60,
          "description": "Quest name shown to player"
        },
        "description": {
          "type": "string",
          "maxLength": 200,
          "description": "Quest description/flavor text"
        },
        "type": {
          "type": "string",
          "enum": ["daily", "weekly", "event"],
          "description": "Quest duration type"
        },
        "duration": {
          "type": "integer",
          "minimum": 3600,
          "description": "Quest duration in seconds (default: 86400 for daily)"
        },
        "startTimeISO": {
          "type": "string",
          "format": "date-time",
          "description": "Quest start time (ISO 8601 UTC)",
          "example": "2026-05-24T00:00:00Z"
        },
        "endTimeISO": {
          "type": "string",
          "format": "date-time",
          "description": "Quest end time (ISO 8601 UTC)",
          "example": "2026-05-25T23:59:59Z"
        },
        "moonId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 13,
          "description": "Required Moon unlock (0 = no requirement)"
        },
        "minPlayerLevel": {
          "type": "integer",
          "minimum": 0,
          "description": "Minimum player level required (0 = no requirement)"
        },
        "objectives": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "$ref": "#/definitions/Objective"
          }
        },
        "rewards": {
          "$ref": "#/definitions/Rewards"
        }
      }
    },
    
    "Objective": {
      "type": "object",
      "required": ["type", "target", "count"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["collect", "defeat", "discover", "tune", "restore", "excavate"],
          "description": "Objective type"
        },
        "target": {
          "type": "string",
          "description": "Target item/enemy/building ID"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "description": "Number required"
        },
        "description": {
          "type": "string",
          "maxLength": 100,
          "description": "Optional custom objective text"
        }
      }
    },
    
    "Rewards": {
      "type": "object",
      "properties": {
        "xp": {
          "type": "integer",
          "minimum": 0,
          "description": "Experience points"
        },
        "rs": {
          "type": "number",
          "minimum": 0,
          "description": "Resonance Score"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Item IDs to reward"
        }
      }
    },
    
    "SeasonalEvent": {
      "type": "object",
      "required": ["eventId", "displayName", "startTimeISO", "endTimeISO"],
      "properties": {
        "eventId": {
          "type": "string",
          "pattern": "^[A-Z_]+_[0-9]{4}$",
          "description": "Unique event identifier",
          "example": "WINTER_SOLSTICE_2026"
        },
        "displayName": {
          "type": "string",
          "maxLength": 60,
          "description": "Event name shown to player"
        },
        "description": {
          "type": "string",
          "maxLength": 200,
          "description": "Event description"
        },
        "startTimeISO": {
          "type": "string",
          "format": "date-time",
          "description": "Event start time (ISO 8601 UTC)"
        },
        "endTimeISO": {
          "type": "string",
          "format": "date-time",
          "description": "Event end time (ISO 8601 UTC)"
        },
        "theme": {
          "$ref": "#/definitions/EventTheme"
        },
        "quests": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Quest IDs unlocked during this event"
        },
        "rewards": {
          "type": "object",
          "properties": {
            "cosmetics": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Cosmetic item IDs"
            },
            "items": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Item IDs"
            }
          }
        },
        "dialogueContext": {
          "type": "string",
          "description": "Dialogue context key for event-specific lines"
        }
      }
    },
    
    "EventTheme": {
      "type": "object",
      "properties": {
        "weatherOverride": {
          "type": "string",
          "enum": ["clear", "rain", "snow", "fog", "storm"],
          "description": "Weather system override"
        },
        "skyboxTint": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "description": "Skybox tint color (hex format)",
          "example": "#88CCFF"
        },
        "ambientAudio": {
          "type": "string",
          "description": "Ambient audio clip ID"
        },
        "decorationPrefabs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Decoration prefab IDs to spawn"
        }
      }
    }
  },
  
  "oneOf": [
    {
      "title": "Daily Quest File",
      "$ref": "#/definitions/DailyQuest"
    },
    {
      "title": "Seasonal Event File",
      "$ref": "#/definitions/SeasonalEvent"
    }
  ],
  
  "examples": [
    {
      "title": "Example Daily Quest",
      "data": {
        "questId": "DAILY_2026_05_24_001",
        "displayName": "Crystal Collector",
        "description": "Collect 10 resonance crystals within 24 hours",
        "type": "daily",
        "duration": 86400,
        "startTimeISO": "2026-05-24T00:00:00Z",
        "endTimeISO": "2026-05-25T23:59:59Z",
        "moonId": 1,
        "minPlayerLevel": 5,
        "objectives": [
          {
            "type": "collect",
            "target": "resonance_crystal",
            "count": 10,
            "description": "Collect resonance crystals"
          }
        ],
        "rewards": {
          "xp": 500,
          "rs": 50,
          "items": ["aether_shard", "crystal_shard"]
        }
      }
    },
    {
      "title": "Example Winter Event",
      "data": {
        "eventId": "WINTER_SOLSTICE_2026",
        "displayName": "Winter Solstice Celebration",
        "description": "The longest night brings ancient harmonies",
        "startTimeISO": "2026-12-21T00:00:00Z",
        "endTimeISO": "2026-12-28T23:59:59Z",
        "theme": {
          "weatherOverride": "snow",
          "skyboxTint": "#88CCFF",
          "ambientAudio": "winter_winds",
          "decorationPrefabs": ["snowflake_vfx", "icicle_prop"]
        },
        "quests": ["WINTER_MAIN_001", "WINTER_SIDE_001"],
        "rewards": {
          "cosmetics": ["winter_cloak", "frost_aura"],
          "items": ["solstice_token"]
        },
        "dialogueContext": "winter_solstice"
      }
    }
  ]
}
